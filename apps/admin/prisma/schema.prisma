// Historial de importaciones masivas de clientes (CSV). `results` guarda el
// detalle por fila (ImportRowResult[]): fila, estado, nombre, clienteId, mensaje.
model ClienteImport {
  id          String   @id @default(cuid())
  createdById String?
  createdBy   User?    @relation("ClienteImportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // "procesando" | "completado" | "cancelado"
  status      String   @default("procesando")
  total       Int
  created     Int      @default(0)
  skipped     Int      @default(0)
  failed      Int      @default(0)
  results     Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

/// Token de un solo uso para establecer una contraseña: la invitación de un
/// usuario del portal, la de un cliente, o el restablecimiento de cualquiera de
/// los dos. Solo se guarda el hash (sha256): el token en claro existe una vez,
/// dentro del enlace, y ni siquiera nosotros podemos volver a leerlo.
///
/// Apunta a **un** cliente o a **un** usuario, nunca a los dos ni a ninguno
/// (un CHECK lo obliga). Son dos tablas de identidad distintas —el personal
/// vive en User, los clientes en Cliente— pero el enlace, la página y el
/// vencimiento son los mismos, y partirlo en dos tablas habría significado
/// duplicar todo eso para variar solo la clave foránea.
model SetPasswordToken {
  id        String    @id @default(cuid())
  clienteId String?
  userId    String?
  tokenHash String    @unique
  expiresAt DateTime
  /// Cuándo alguien lo abrió y eligió una contraseña. Solo eso.
  usedAt    DateTime?
  /// Cuándo lo dimos de baja nosotros: porque se emitió uno más nuevo, o
  /// porque se le revocó el acceso a la persona.
  ///
  /// Aparte de `usedAt` porque no son lo mismo y la diferencia se ve: decirle
  /// "este enlace ya se usó" a quien nunca lo abrió lo manda a preguntarse
  /// quién entró con él.
  anuladoEl DateTime?
  createdAt DateTime  @default(now())

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([userId])
}

// ──────────────────────────────────────────────
// Informes mensuales (PDFs)
// ──────────────────────────────────────────────

model Informe {
  id            String    @id @default(cuid())
  clienteId     String
  /// Correlativo corto, para nombrarlo en voz alta. Como el de visitas y
  /// órdenes: cada tabla tiene su propia secuencia y eso está bien, porque
  /// nunca se muestra un número sin decir de qué es.
  numero        Int       @unique @default(autoincrement())
  titulo        String
  /// La fecha que **sale impresa** en el PDF, y solo eso.
  ///
  /// Va aparte de `generatedAt` porque son dos hechos distintos: cuándo se
  /// armó el archivo y con qué fecha se entrega. Un informe de agosto se puede
  /// generar el 2 de septiembre y tiene que decir agosto; y regenerarlo para
  /// corregir una foto no puede cambiarle la fecha al documento que el cliente
  /// ya tiene. `generatedAt` sigue siendo el instante real, para auditoría.
  fecha         DateTime  @db.Date
  fechaDesde    DateTime?
  fechaHasta    DateTime?
  pdfKey        String
  pdfUrl        String
  // Per-informe signers: [{ nombre: string, cedula?: string }]. 1 to 3.
  firmantes     Json      @default("[]")
  generatedById String
  /// Nombre de quien lo creó, congelado. El id sirve para filtrar; el texto es
  /// lo que pasó, y sobrevive a que la cuenta se renombre o se borre.
  generatedByNombre String?
  generatedAt   DateTime  @default(now())

  /// Quién y cuándo lo tocó por última vez. Nulo mientras nadie lo editó: eso
  /// dice "sigue como se creó", que es distinto de "lo actualizó quien lo hizo".
  updatedById     String?
  updatedByNombre String?
  updatedAt       DateTime @updatedAt

  /// En qué versión va. Arranca en 1 y sube con cada edición.
  versionActual Int @default(1)

  cliente     Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  generatedBy User             @relation("InformeGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  updatedBy   User?            @relation("InformeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  visitas     InformeVisita[]
  secciones   InformeSeccion[]
  versiones   InformeVersion[]
  borradores  InformeBorrador[]

  @@index([clienteId])
  @@index([generatedAt])
}

/// Una versión del informe: **el PDF que se entregó en ese momento**.
///
/// El informe se puede editar, y editarlo no pisa lo anterior: cada generación
/// deja su archivo. Esa era la razón por la que antes no se editaba —el cliente
/// se quedaba con un PDF que ya no era el nuestro— y guardar las versiones es lo
/// que la resuelve: el que él tiene sigue existiendo y se puede abrir.
///
/// El PDF es el documento. Las tablas `InformeSeccion` / `InformeSeccionFoto`
/// son la versión **actual** —lo que se abre para editar—; una versión vieja
/// conserva su archivo y, en `contenido`, con qué se armó.
model InformeVersion {
  id        String @id @default(cuid())
  informeId String
  /// 1, 2, 3… Único dentro del informe.
  version   Int

  titulo String
  /// La que salió impresa en **esta** versión.
  fecha  DateTime @db.Date
  pdfKey String
  pdfUrl String

  /// Con qué se armó: secciones, fotos y firmantes tal como se mandaron. Es lo
  /// que permite mirar una versión vieja sin depender de las tablas vivas, que
  /// para entonces ya describen otra cosa.
  contenido Json

  generatedById     String?
  generatedByNombre String?
  generatedAt       DateTime @default(now())
  /// Qué se cambió, si alguien lo escribió. Opcional a propósito: obligar a
  /// justificar cada corrección hace que se escriba "corrección" y nada más.
  nota              String?

  informe     Informe @relation(fields: [informeId], references: [id], onDelete: Cascade)
  generatedBy User?   @relation("InformeVersionGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)

  @@unique([informeId, version])
  @@index([informeId])
}

/// Un informe a medio armar.
///
/// No es un `Informe` sin PDF: un informe es un documento emitido, con número y
/// archivo, y un borrador no tiene nada de eso — es el estado del asistente
/// guardado para seguir después. Meterlos en la misma tabla obligaría a que
/// todo lo que lista informes explique cuáles no lo son.
///
/// El contenido va como JSON y no en tablas: nada lo consulta por partes, y
/// mientras se arma cambia de forma todo el tiempo.
model InformeBorrador {
  id        String  @id @default(cuid())
  /// El mismo correlativo que los informes, **de la misma secuencia**.
  ///
  /// Un borrador se nombra en voz alta igual que un informe, así que necesita
  /// número; y tiene que salir del mismo pozo, o el #17 sería dos cosas
  /// distintas. Se pide al crearlo y el informe lo hereda al generarse: el
  /// borrador #17 se convierte en el informe #17.
  ///
  /// Descartar un borrador deja un hueco en la numeración, igual que pasa con
  /// las facturas. Es el precio de poder nombrarlo antes de que exista.
  numero    Int     @unique
  clienteId String?
  titulo    String?
  contenido Json

  /// De qué informe es esta edición a medio hacer. Nulo = es un informe nuevo.
  ///
  /// Editar también se puede dejar por la mitad, y ese borrador no es "un
  /// informe nuevo": al retomarlo hay que volver a la edición del mismo, o se
  /// terminaría creando un duplicado del que se quería corregir.
  informeId String?

  createdById     String?
  createdByNombre String?
  createdAt       DateTime @default(now())
  updatedById     String?
  updatedByNombre String?
  updatedAt       DateTime @updatedAt

  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  /// Se va con el informe: un borrador de una edición de algo que ya no existe
  /// no se puede retomar ni tiene a dónde volver.
  informe   Informe? @relation(fields: [informeId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("InformeBorradorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("InformeBorradorUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt])
  @@index([clienteId])
  @@index([informeId])
}

model InformeVisita {
  informeId String
  visitaId  String

  informe Informe @relation(fields: [informeId], references: [id], onDelete: Cascade)
  visita  Visita  @relation(fields: [visitaId], references: [id], onDelete: Cascade)

  @@id([informeId, visitaId])
  @@index([visitaId])
}

model InformeSeccion {
  id          String  @id @default(cuid())
  informeId   String
  /// Producto que origina la sección. Null = sección personalizada.
  productoId  String?
  titulo      String
  descripcion String? @db.Text
  orden       Int

  /// Empieza en una hoja nueva. Para separar bloques que no se leen juntos.
  saltoDePagina Boolean @default(false)
  /// Cuántas fotos por fila: 2 (grandes), 3 (por defecto) o 4 (chicas). Es la
  /// palanca de densidad — pocas fotos grandes llenan la hoja, muchas chicas la
  /// dejan corta.
  fotosPorFila Int @default(3)

  informe  Informe              @relation(fields: [informeId], references: [id], onDelete: Cascade)
  producto Producto?            @relation(fields: [productoId], references: [id], onDelete: SetNull)
  fotos    InformeSeccionFoto[]

  @@index([informeId])
  @@index([productoId])
}

/// Una foto de una sección: puede venir de una visita (visitaMediaId) o haber
/// sido subida directamente al informe. `key`/`url` siempre se guardan para que
/// el informe siga siendo editable aunque se borre la media de la visita.
/// Una foto de una sección del informe.
///
/// `key` y `url` son **lo que se imprimió**: el PDF ya salió con esa imagen y
/// eso no cambia. Los otros dos campos dicen de dónde vino, y son excluyentes:
///
/// - `visitaMediaId` — de la galería de una visita. El archivo es de la visita.
/// - `mediaId` — de la biblioteca. El archivo es de la biblioteca, y puede
///   estar en un producto o en otro informe.
///
/// Los dos en null es una foto vieja, subida cuando el informe era el único
/// dueño de su archivo. De quién es el archivo decide **quién lo borra**.
model InformeSeccionFoto {
  id            String  @id @default(cuid())
  seccionId     String
  orden         Int
  key           String
  url           String
  visitaMediaId String?
  mediaId       String?

  seccion     InformeSeccion @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  visitaMedia VisitaMedia?   @relation(fields: [visitaMediaId], references: [id], onDelete: SetNull)
  media       Media?         @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([seccionId, orden])
  @@index([visitaMediaId])
  @@index([mediaId])
}

model EmpresaConfig {
  id        String   @id @default("default")
  nombre    String?
  logoKey   String?
  logoUrl   String?
  updatedAt DateTime @updatedAt
}

/// A nombre de quién se emite un comprobante electrónico ante el SRI.
///
/// Es una **tabla y no una fila de configuración** porque el vivero factura con
/// más de un RUC y elige cuál al emitir. Cada uno es un contribuyente distinto
/// para el SRI: su propio certificado, su propia numeración y su propio trámite
/// de ambiente de pruebas.
///
/// Los campos son los que el XML exige en `infoTributaria`, ni más ni menos.
model Emisor {
  id                       String  @id @default(cuid())
  /// 13 dígitos. Es la identidad del emisor ante el SRI.
  ruc                      String  @unique
  razonSocial              String
  nombreComercial          String?
  /// Dirección de la matriz y del establecimiento que emite. El SRI las pide
  /// por separado aunque casi siempre coincidan.
  dirMatriz                String
  direccionEstablecimiento String
  /// Tres dígitos cada uno: "001". Con el secuencial forman "001-002-000000001".
  establecimiento          String  @default("001")
  puntoEmision             String  @default("001")

  obligadoContabilidad  Boolean @default(true)
  /// Número de resolución, cuando el SRI lo designó contribuyente especial.
  contribuyenteEspecial String?
  /// Número de resolución de agente de retención, si lo es.
  agenteRetencion       String?

  /// `PRUEBAS` (1) o `PRODUCCION` (2). Son dos mundos separados del SRI, con
  /// distinta URL y distinta autorización: lo emitido en pruebas no vale nada.
  ambiente AmbienteSri @default(PRUEBAS)

  /// El `.p12` con el que se firma, **cifrado** (AES-256-GCM). Es una clave
  /// privada que firma documentos tributarios en nombre de la empresa: no sale
  /// nunca por una API, no se registra en logs y solo la lee el servidor al
  /// momento de firmar.
  certificado         Bytes?
  /// Su contraseña, cifrada con la misma clave.
  certificadoPassword Bytes?
  /// A nombre de quién está el certificado y hasta cuándo sirve. Se leen del
  /// propio `.p12` al cargarlo, para poder avisar antes de que caduque: vencido,
  /// ese RUC deja de poder facturar.
  certificadoSujeto   String?
  certificadoVence    DateTime?

  activo         Boolean @default(true)
  /// El que viene elegido al emitir. Solo uno.
  predeterminado Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  secuenciales SecuencialSri[]
  facturas     Factura[]

  @@index([activo])
}

enum AmbienteSri {
  PRUEBAS
  PRODUCCION
}

/// La numeración de cada serie del SRI.
///
/// Va por emisor, establecimiento, punto de emisión **y tipo de comprobante**:
/// una factura y una nota de crédito llevan series distintas. Se incrementa con
/// un `UPDATE ... RETURNING` atómico, que es lo único que evita que dos
/// emisiones simultáneas pidan el mismo número — y un número repetido lo
/// rechaza el SRI.
model SecuencialSri {
  id              String @id @default(cuid())
  emisorId        String
  establecimiento String
  puntoEmision    String
  /// `FACTURA`, `NOTA_CREDITO`… tal como los nombra la librería.
  tipoDocumento   String
  /// El último entregado. El próximo es este + 1.
  valor           Int    @default(0)

  emisor Emisor @relation(fields: [emisorId], references: [id], onDelete: Cascade)

  @@unique([emisorId, establecimiento, puntoEmision, tipoDocumento])
}

model Firmante {
  id        String   @id @default(cuid())
  nombre    String
  cedula    String?
  isDefault Boolean  @default(false)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault])
}

// ──────────────────────────────────────────────
// Libro de ventas
//
// Una orden es "lo que se vendió": existe desde que se hizo el trabajo, antes
// de que exista factura. Toda la plata vive en `OrdenLinea`, venga de una
// suscripción, de una visita única o (más adelante) de un bien. Así un reporte
// de ventas es una sola consulta en vez de un union por cada tipo de ingreso,
// y el historial completo de ventas queda en nuestra base.
// ──────────────────────────────────────────────

/// Tres estados y una sola idea: si la orden está viva y si se puede tocar.
///
/// No hay FACTURADA porque facturar dejó de ser un paso aparte —confirmar
/// emite— así que CONFIRMADA **es** "tiene factura viva". Que esté cobrada o no
/// se lee del saldo de esa factura, no del estado de la orden: son dos ejes
/// distintos y mezclarlos obligaba a inventar un estado por combinación.
///
/// Una emisión fallida deja la orden en BORRADOR, que es el único estado
/// editable: justo donde hay que estar para arreglar la causa.
enum EstadoOrden {
  BORRADOR
  CONFIRMADA
  ANULADA
}

model Orden {
  id                String  @id @default(cuid())
  clienteId         String
  /// Con qué datos se va a facturar. Se elige al armar la orden, cuando el
  /// vendedor tiene al cliente delante; al emitir ya es tarde para preguntar.
  /// Nullable porque una orden puede existir antes de saberlo.
  datoFacturacionId String?
  /// Correlativo interno legible. No es el número de factura del SRI.
  numero            Int     @unique @default(autoincrement())

  /// De qué plan es esta orden, cuando es de un plan.
  ///
  /// Las visitas viven en `OrdenVisita` porque pueden ser **varias**; un plan
  /// no: sus períodos se renuevan solos y cada orden cubre uno.
  ///
  /// Null y sin `OrdenVisita` = orden suelta, armada a mano.
  suscripcionId String?
  fecha         DateTime    @db.Date
  estado        EstadoOrden @default(BORRADOR)
  notas         String?     @db.Text

  /// Totales denormalizados, recalculados desde las líneas en cada escritura.
  subtotal Decimal @default(0) @db.Decimal(10, 2)
  iva      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @default(0) @db.Decimal(10, 2)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  cliente         Cliente          @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  datoFacturacion DatoFacturacion? @relation(fields: [datoFacturacionId], references: [id], onDelete: SetNull)
  suscripcion     Suscripcion?     @relation(fields: [suscripcionId], references: [id], onDelete: Restrict)
  createdBy       User?            @relation("OrdenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?            @relation("OrdenUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  lineas          OrdenLinea[]
  facturas        Factura[]
  visitas         OrdenVisita[]

  @@index([clienteId, fecha])
  @@index([estado])
  @@index([datoFacturacionId])
  @@index([suscripcionId])
}

/// De qué visitas es una orden.
///
/// Es una lista y no una columna porque **una orden puede cubrir varias
/// visitas**: es normal cobrar el mes entero de alguien de una vez. Lo mantiene
/// el servidor desde la procedencia de las líneas, así que no se recibe de
/// afuera — una asignación que no trajera trabajo sería una que no queda
/// registrada en ningún lado.
///
/// Existe además de `OrdenLineaOrigen` porque contesta otra pregunta: aquélla
/// dice de dónde sale cada peso, ésta "¿de qué es esta orden?", que es la que
/// se hace primero y la que obligaba a recorrer las líneas.
model OrdenVisita {
  ordenId  String
  visitaId String

  orden  Orden  @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  /// `Restrict`: una visita con orden no se borra sin resolver la orden antes.
  visita Visita @relation(fields: [visitaId], references: [id], onDelete: Restrict)

  @@id([ordenId, visitaId])
  @@index([visitaId])
}

model OrdenLinea {
  id       String @id @default(cuid())
  ordenId  String
  posicion Int    @default(0)

  /// Snapshot: sobrevive a que después renombren o borren el producto.
  descripcion    String
  cantidad       Decimal @default(1) @db.Decimal(10, 2)
  precioUnitario Decimal @db.Decimal(10, 2)
  ivaTasa        Decimal @default(0) @db.Decimal(5, 2)
  subtotal       Decimal @db.Decimal(10, 2)
  iva            Decimal @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  /// Qué se vendió. Obligatorio: de acá sale el `codigoPrincipal` que el SRI
  /// pide en cada detalle, así que una línea sin producto sería una venta que
  /// no se puede cobrar. Es además lo que hace que un reporte por producto sea
  /// un `groupBy` y no una reconstrucción.
  productoId        String
  /// **Qué variante se vendió. Siempre hay una.**
  ///
  /// Todo producto tiene **al menos** una —un servicio y un bien sin opciones
  /// tienen exactamente una; con opciones hay una por combinación— así que acá
  /// nunca falta. Antes era opcional "porque un servicio no tiene", y eso hacía
  /// que una línea apuntara a un producto o a una variante según el tipo: dos
  /// formas para la misma cosa, y una rama en cada lugar que preguntaba el SKU,
  /// el precio o el stock.
  ///
  /// De acá salen el SKU impreso y el stock que baja.
  varianteId        String
  suscripcionItemId String?
  periodoInicio     DateTime? @db.Date
  periodoFin        DateTime? @db.Date

  orden           Orden              @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  /// `Restrict` y no `SetNull`: un producto que ya se vendió no se puede
  /// borrar. Perder el vínculo dejaría la línea fuera de todo reporte y la
  /// factura sin con qué reconciliarse.
  producto        Producto           @relation(fields: [productoId], references: [id], onDelete: Restrict)
  /// `Restrict` por lo mismo que el producto: una variante ya vendida no se
  /// borra. Eso hace, de paso, que sacar un eje avise en vez de romper.
  variante        Variante           @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  suscripcionItem SuscripcionItem?   @relation(fields: [suscripcionItemId], references: [id], onDelete: SetNull)
  /// De qué trabajos de visita sale esta línea. Pueden ser varios.
  origenes        OrdenLineaOrigen[]

  /// Impide facturar dos veces el mismo período de la misma suscripción.
  @@unique([suscripcionItemId, periodoInicio])
  @@index([ordenId, posicion])
  @@index([productoId])
  @@index([varianteId])
}

/// Qué trabajo de qué visita paga una línea de orden.
///
/// Era una columna única en `OrdenLinea`, y eso obligaba a una línea por
/// visita: el mismo producto hecho en dos visitas salía dos veces en la misma
/// orden, lo que no le dice nada a nadie —es el mismo producto— y encima
/// duplicaba la decisión de precio. Ahora una línea junta los dos trabajos.
///
/// `visitaProductoId` sigue siendo **único en toda la tabla**: eso es lo que
/// impide cobrar el mismo trabajo dos veces, y no depende de ninguna
/// validación de aplicación.
model OrdenLineaOrigen {
  ordenLineaId     String
  visitaProductoId String @unique

  ordenLinea     OrdenLinea     @relation(fields: [ordenLineaId], references: [id], onDelete: Cascade)
  /// `Restrict`: el trabajo facturado no se borra. Como `VisitaProducto`
  /// cascadea desde `Visita`, esto también protege a la visita entera.
  visitaProducto VisitaProducto @relation(fields: [visitaProductoId], references: [id], onDelete: Restrict)

  @@id([ordenLineaId, visitaProductoId])
  @@index([ordenLineaId])
}

enum EstadoFactura {
  PENDIENTE
  FIRMADO
  ENVIADO_SRI
  AUTORIZADO
  RECHAZADO
}

/// Qué comprobante se emitió por una orden.
enum TipoDocumento {
  FACTURA
  /// La forma de corregir una factura que el SRI ya autorizó. Vive en la misma
  /// tabla porque es otro comprobante: se firma, se manda y se consulta igual.
  NOTA_CREDITO
}

/// Los datos con los que se le emite una factura a un cliente.
///
/// Van aparte del Cliente porque uno puede facturar de más de una forma: a
/// nombre propio y al de su empresa, o a distintas razones sociales de un mismo
/// contacto. Y porque el nombre con el que se lo conoce en el portal no tiene
/// por qué ser la razón social del SRI.
///
/// Editarlo no rompe el historial: cada Factura guarda además un snapshot de la
/// razón social e identificación con las que se emitió.
model DatoFacturacion {
  id        String @id @default(cuid())
  clienteId String

  /// `CEDULA` o `RUC`. La cédula se valida por módulo 10 antes de emitir.
  tipoIdentificacion TipoIdentificacion
  identificacion     String
  /// Lo que se imprime en la factura, no el nombre del portal.
  razonSocial        String
  /// Natural o jurídica.
  tipoPersona        TipoPersona
  direccion          String?
  telefono           String?
  email              String?

  /// El que se propone al facturar.
  esPredeterminado Boolean @default(false)
  /// Los archivados no se ofrecen, pero las facturas viejas los siguen citando.
  archivado        Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("DatoFacturacionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?     @relation("DatoFacturacionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  facturas  Factura[]
  ordenes   Orden[]

  /// No se repite la misma identificación dos veces en el mismo cliente.
  @@unique([clienteId, identificacion])
  @@index([clienteId, archivado])
}

enum TipoIdentificacion {
  CEDULA
  RUC
}

model Factura {
  id      String @id @default(cuid())
  ordenId String

  /// Con qué RUC se emitió.
  emisorId String?
  emisor   Emisor? @relation(fields: [emisorId], references: [id], onDelete: Restrict)

  /// ─── Lo que devuelve el SRI ──────────────────────────────────────────
  ///
  /// En el esquema *offline* la clave de acceso **es** el número de
  /// autorización: se calcula acá antes de mandar nada, y el SRI la confirma.
  claveAcceso       String?      @unique
  /// Contra qué mundo se emitió. Lo de `PRUEBAS` no vale como comprobante.
  ambienteSri       AmbienteSri?
  /// `AUTORIZADO`, `ENVIADO`, `DEVUELTO`… tal como lo reporta la emisión.
  estadoSri         String?
  fechaAutorizacion DateTime?
  /// Dónde quedó el XML firmado y autorizado, en R2. Hay que conservarlo.
  xmlKey            String?
  /// Lo que el SRI respondió cuando rechazó, para poder mostrarlo entero.
  mensajesSri       Json?

  /// Cuándo se le mandó al cliente y a qué correo. Sin esto no hay forma de
  /// saber si le llegó, y el reflejo es mandarla de nuevo "por si acaso".
  enviadoEl DateTime?
  enviadoA  String?

  /// Qué factura corrige esta nota de crédito, y por qué. El SRI exige las dos
  /// cosas en el XML: sin el documento modificado la nota no se refiere a nada.
  facturaModificadaId String?
  facturaModificada   Factura?  @relation("NotasDeCredito", fields: [facturaModificadaId], references: [id], onDelete: Restrict)
  notasDeCredito      Factura[] @relation("NotasDeCredito")
  motivo              String?

  /// `001-001-000000123`. Único **por tipo**: una factura y una nota de
  /// crédito tienen cada una su propia serie, así que `001-001-000000001`
  /// existe una vez de cada.
  numero       String
  tipo         TipoDocumento @default(FACTURA)
  fechaEmision DateTime      @db.Date
  estado       EstadoFactura @default(PENDIENTE)
  /// El número de autorización que devolvió el SRI. En el esquema offline es
  /// la misma clave de acceso, pero se guarda tal como vino.
  autorizacion String?

  /// Con qué datos se emitió. El id es la referencia; los dos campos de abajo
  /// son el snapshot y son la verdad — el dato puede editarse o archivarse, y
  /// el papel que recibió el cliente no cambia.
  datoFacturacionId String?
  razonSocial       String?
  identificacion    String?

  subtotal0       Decimal  @default(0) @db.Decimal(10, 2)
  subtotalGravado Decimal  @default(0) @db.Decimal(10, 2)
  iva             Decimal  @default(0) @db.Decimal(10, 2)
  total           Decimal  @default(0) @db.Decimal(10, 2)
  /// Lo que falta cobrar: el total menos los cobros registrados. Se recalcula
  /// desde `Cobro` en cada movimiento, nunca restándole al valor guardado.
  saldo           Decimal? @db.Decimal(10, 2)

  anulada   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orden           Orden                  @relation(fields: [ordenId], references: [id], onDelete: Restrict)
  datoFacturacion DatoFacturacion?       @relation(fields: [datoFacturacionId], references: [id], onDelete: SetNull)
  lineas          FacturaLinea[]
  movimientos     MovimientoInventario[]

  cobros Cobro[]

  @@unique([tipo, numero])
  @@index([ordenId])
  @@index([estado])
  @@index([facturaModificadaId])
}

/// Un cobro contra una factura.
///
/// No viaja a ningún lado. Al SRI la forma de pago se le declara **al emitir**,
/// y el comprobante ya salió: esto es la cuenta corriente del vivero, no un
/// dato tributario. Por eso las formas de pago son las que usa la gente, no el
/// catálogo del SRI.
model Cobro {
  id         String    @id @default(cuid())
  facturaId  String
  /// El día que entró la plata, que puede no ser el día que se registra.
  fecha      DateTime  @db.Date
  monto      Decimal   @db.Decimal(10, 2)
  formaPago  FormaPago
  /// N° de transferencia, de cheque, del voucher. Lo que permite encontrarlo.
  referencia String?
  nota       String?

  createdAt       DateTime @default(now())
  createdById     String?
  /// El nombre congelado: el id se queda sin dueño si la cuenta se elimina.
  createdByNombre String?

  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("CobroCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([facturaId])
}

enum FormaPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CHEQUE
  OTRO
}

/// Lo que salió impreso en el documento, línea por línea.
///
/// Existe porque la factura **puede no tener la forma de la orden**: lo normal
/// acá es cobrar varios trabajos de un período como una sola línea de
/// "servicio de mantenimiento". Mientras las dos formas eran la misma, la
/// factura se podía reconstruir desde la orden; en cuanto pueden diferir, esa
/// reconstrucción es una mentira sobre un documento que ya se entregó.
///
/// No hay puente hacia `OrdenLinea` a propósito: la procedencia de cada peso
/// —qué visita, qué período— vive en la orden, que es el libro de ventas. Esto
/// es el espejo de lo legal. Lo que ata las dos caras es que **cuadren**: misma
/// base imponible por cada tasa.
model FacturaLinea {
  id        String @id @default(cuid())
  facturaId String
  posicion  Int    @default(0)

  /// Snapshot de lo que salió impreso: va tal cual al `descripcion` del
  /// detalle del XML.
  descripcion    String
  cantidad       Decimal @default(1) @db.Decimal(10, 2)
  precioUnitario Decimal @db.Decimal(10, 2)
  ivaTasa        Decimal @default(0) @db.Decimal(5, 2)
  subtotal       Decimal @db.Decimal(10, 2)
  iva            Decimal @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  /// De dónde sale el `codigoPrincipal`, y con qué queda asociada la venta.
  productoId String
  /// Qué variante salió. Siempre hay una: su SKU es lo que se imprime como
  /// `codigoPrincipal`, y es de dónde se descontó el stock.
  varianteId String

  factura  Factura   @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  variante Variante  @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  /// `Restrict` como en `OrdenLinea`: un producto ya facturado no se borra, o
  /// la factura se queda sin con qué reconciliarse.
  producto Producto  @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@index([facturaId, posicion])
  @@index([productoId])
  @@index([varianteId])
}
