generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// NextAuth models
// ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum UserRole {
  ADMIN
  STAFF
  PERSONAL_ADMIN
  PERSONAL
  CLIENTE
}

/// Qué es el ítem. Se mapea al `tipo` de Contífico (SER / PRO).
enum TipoProducto {
  SERVICIO
  BIEN
}

/// Cómo se vende. Vive solo en el portal: Contífico no conoce suscripciones,
/// solo recibe una factura por período.
/// Cada cuánto se cobra una suscripción. El precio del contrato es por período,
/// no por mes: una anual de $1200 se cobra $1200 una vez al año.
enum Periodicidad {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

/// Quién creó el ítem. Define hacia qué lado sincroniza y evita que el portal
/// y Contífico se pisen: cada uno es dueño de lo que crea.
enum OrigenProducto {
  PORTAL
  CONTIFICO
}

/// Tipo de persona para facturación. Espeja el campo `tipo` de Contífico.
enum TipoPersona {
  NATURAL
  JURIDICA
}

enum EstadoServicio {
  ACTIVO
  PAUSADO
  CANCELADO
}

enum EstadoVisita {
  PROGRAMADA
  COMPLETADA
  INCOMPLETA
  CANCELADA
}

enum TipoNotificacion {
  RECORDATORIO_VISITA_CLIENTE
  CONFIRMACION_VISITA_CLIENTE
  RESUMEN_DIARIO_ADMIN
  ALERTA_VISITA_COMPLETADA
  ALERTA_VISITA_INCOMPLETA
  MENSAJE_ENTRANTE_CLIENTE
  AUTENTICACION_OTP
  INVITACION_CUENTA
}

enum EstadoNotificacion {
  PENDIENTE
  ENVIADA
  FALLIDA
}

enum DestinatarioTipo {
  CLIENTE
  ADMIN
  PERSONAL
}

// ──────────────────────────────────────────────
// Application models
// ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  apellido      String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(STAFF)
  /// Cuándo se le revocó el acceso, o null si lo tiene.
  ///
  /// Una fecha y no un booleano: cuando alguien pregunta "¿desde cuándo no
  /// entra?" la respuesta ya está guardada. Revocar no borra la cuenta —su
  /// nombre sigue firmando las visitas e informes que hizo— solo cierra la
  /// puerta: los dos caminos de login la rechazan, sus enlaces pendientes se
  /// anulan y sus sesiones móviles dejan de renovarse.
  accesoRevocadoEl DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  /// Enlaces de invitación / restablecimiento pendientes o ya usados.
  setPasswordTokens SetPasswordToken[]

  // Audit relations
  clientesCreated         Cliente[]         @relation("ClienteCreatedBy")
  clientesUpdated         Cliente[]         @relation("ClienteUpdatedBy")
  productosCreated        Producto[]        @relation("ProductoCreatedBy")
  productosUpdated        Producto[]        @relation("ProductoUpdatedBy")
  personalCreated         Personal[]        @relation("JardineroCreatedBy")
  personalUpdated         Personal[]        @relation("JardineroUpdatedBy")
  gruposCreated           Grupo[]           @relation("GrupoCreatedBy")
  gruposUpdated           Grupo[]           @relation("GrupoUpdatedBy")
  suscripcionesCreated    Suscripcion[]     @relation("SuscripcionCreatedBy")
  suscripcionesUpdated    Suscripcion[]     @relation("SuscripcionUpdatedBy")
  visitasCreated          Visita[]          @relation("VisitaCreatedBy")
  visitasUpdated          Visita[]          @relation("VisitaUpdatedBy")
  visitasCompletadas      Visita[]          @relation("VisitaCompletadaPor")
  visitaPersonalAdded     VisitaPersonal[]  @relation("VisitaPersonalAddedBy")
  visitaPersonalRemoved   VisitaPersonal[]  @relation("VisitaPersonalRemovedBy")
  personal                Personal?
  sectorAdmins            SectorAdmin[]
  cliente                 Cliente?
  pushTokens              PushToken[]
  refreshTokens           RefreshToken[]
  visitaMessages          VisitaMessage[]
  visitaChatReads         VisitaChatRead[]
  informesGenerados       Informe[]         @relation("InformeGeneratedBy")
  clienteImports          ClienteImport[]   @relation("ClienteImportCreatedBy")
  ordenesCreated          Orden[]           @relation("OrdenCreatedBy")
  ordenesUpdated          Orden[]           @relation("OrdenUpdatedBy")
  datosFacturacionCreated DatoFacturacion[] @relation("DatoFacturacionCreatedBy")
  datosFacturacionUpdated DatoFacturacion[] @relation("DatoFacturacionUpdatedBy")
}

model Cliente {
  id              String  @id @default(cuid())
  nombre          String
  apellido        String?
  empresa         String?
  email           String?
  telefono        String?
  ciudad          String?
  sectorId        String?
  direccion       String?
  numeroCasa      String?
  referencia      String? @db.Text
  notas           String? @db.Text
  metrosCuadrados Float?

  /// Identificación tributaria. Contífico exige `cedula` y `tipo` para emitir
  /// una factura; hoy están vacías y se backfillean desde su padrón.
  cedula      String?
  ruc         String?
  tipoPersona TipoPersona?

  recibirRecordatorios  Boolean   @default(true)
  recibirConfirmaciones Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  createdById String?
  updatedById String?
  userId      String? @unique
  createdBy   User?   @relation("ClienteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("ClienteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  sector            Sector?            @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  suscripciones     Suscripcion[]
  datosFacturacion  DatoFacturacion[]
  visitas           Visita[]
  ordenes           Orden[]
  informes          Informe[]
  setPasswordTokens SetPasswordToken[]
}

/// Catálogo único: servicios de jardinería y, más adelante, bienes de vivero.
/// En Contífico ambos son `producto`; lo que los distingue acá es `tipo`.
model Producto {
  id           String         @id @default(cuid())
  nombre       String
  descripcion  String?        @db.Text
  /// Inmutable después de crear: cambiarlo dejaría líneas de orden con una
  /// semántica que ya no corresponde. No hay un eje "único vs recurrente" en el
  /// catálogo: lo recurrente lo define la suscripción que contiene al producto,
  /// no el producto.
  tipo   TipoProducto   @default(SERVICIO)
  origen OrigenProducto @default(PORTAL)

  /// Código de sincronización con Contífico. Es la llave: Contífico rechaza
  /// códigos repetidos (409 con el id del existente) pero acepta nombres
  /// repetidos, así que el código es lo único que evita duplicados.
  codigo String? @unique

  /// Producto equivalente en Contífico. `detalles[].producto_id` es obligatorio
  /// al facturar, así que cada ítem se vincula una vez con su producto. Único:
  /// dos productos del portal apuntando al mismo de Contífico harían ambigua
  /// la factura y romperían la trazabilidad hacia atrás.
  contificoProductoId  String?  @unique
  contificoCategoriaId String?
  /// Tasa de IVA por defecto (porcentaje). En Ecuador conviven 0% y 15%.
  ivaTasa              Decimal? @db.Decimal(5, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  updatedById String?
  createdBy   User?   @relation("ProductoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("ProductoUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  suscripcionItems SuscripcionItem[]
  visitaProductos  VisitaProducto[]
  visitaMedia      VisitaMedia[]
  informeSecciones InformeSeccion[]
  ordenLineas      OrdenLinea[]
  facturaLineas    FacturaLinea[]
}

/// Un contrato recurrente. Agrupa uno o más productos que se cobran juntos en
/// el mismo ciclo: cada renovación genera una orden con una línea por ítem.
model Suscripcion {
  id           String         @id @default(cuid())
  /// Número corto para nombrarla: "Suscripción #12".
  ///
  /// Secuencia **propia**, independiente de la de órdenes. Que exista una orden
  /// #12 y una suscripción #12 a la vez está bien: son cosas distintas y en
  /// pantalla siempre van con su prefijo. Compartir una sola secuencia las
  /// dejaría salteadas —#3, #17, #40— sin ganar nada a cambio.
  numero       Int            @unique @default(autoincrement())
  clienteId    String
  estado       EstadoServicio @default(ACTIVO)
  /// El ciclo lo define la suscripción, no el producto: el mismo producto puede
  /// ser mensual para un cliente y trimestral para otro.
  periodicidad Periodicidad   @default(MENSUAL)
  fechaInicio  DateTime       @db.Date
  fechaFin     DateTime?      @db.Date
  notas        String?        @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  cliente   Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  createdBy User?             @relation("SuscripcionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?             @relation("SuscripcionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items     SuscripcionItem[]
  ordenes   Orden[]
  visitas   Visita[]

  @@index([clienteId, estado])
}

/// Un producto dentro de una suscripción, con su propio precio e IVA. La tasa
/// va acá y no en la cabecera porque una misma factura puede mezclar líneas al
/// 0% y al 15%.
model SuscripcionItem {
  id                String  @id @default(cuid())
  suscripcionId     String
  productoId        String
  precio            Decimal @db.Decimal(10, 2)
  ivaTasa           Decimal @default(0) @db.Decimal(5, 2)
  /// Visitas que incluye **por período de cobro**: en una trimestral son las
  /// del trimestre. Es informativo — no es un tope, se puede agendar de más.
  visitasPorPeriodo Int?

  suscripcion     Suscripcion      @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)
  producto        Producto         @relation(fields: [productoId], references: [id], onDelete: Restrict)
  visitaProductos VisitaProducto[]
  ordenLineas     OrdenLinea[]

  @@unique([suscripcionId, productoId])
  @@index([productoId])
}

model Personal {
  id           String    @id @default(cuid())
  nombre       String
  apellido     String?
  telefono     String?
  especialidad String?
  sueldo       Float?
  tipo         String?
  estado       String    @default("ACTIVO")
  userId       String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  createdById String?
  updatedById String?
  createdBy   User?   @relation("JardineroCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("JardineroUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  user    User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  grupos  GrupoMiembro[]
  visitas VisitaPersonal[]
}

model Grupo {
  id          String    @id @default(cuid())
  nombre      String
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdById String?
  updatedById String?
  createdBy   User?   @relation("GrupoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("GrupoUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  miembros GrupoMiembro[]
  visitas  Visita[]
}

model Visita {
  id              String       @id @default(cuid())
  /// Número corto para nombrarla: "Visita #34".
  ///
  /// Secuencia propia, como la de órdenes y suscripciones. En pantalla siempre
  /// va con su prefijo, así que que coexistan la orden #34 y la visita #34 no
  /// confunde a nadie.
  numero          Int          @unique @default(autoincrement())
  clienteId       String
  /// De qué plan es esta visita, si es de alguno.
  ///
  /// La decisión es **de la visita**, no de cada producto: "esta visita es del
  /// plan mensual" o "esta visita es un trabajo aparte". Con el plan puesto,
  /// cada producto que **esté en ese plan** queda cubierto —eso ya no se
  /// decide, se deduce del plan— y lo que no esté se cobra como trabajo suelto.
  ///
  /// En null, todo lo que se haga se cobra aparte. Es lo que permite hacerle a
  /// alguien una visita extra de algo que igual tiene contratado.
  suscripcionId   String?
  fechaProgramada DateTime     @db.Date
  fechaRealizada  DateTime?    @db.Date
  horaEntrada     String?
  horaSalida      String?
  estado          EstadoVisita @default(PROGRAMADA)
  grupoId         String?
  notas           String?      @db.Text
  notasIncompleto String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  createdById     String?
  updatedById     String?
  /// El nombre de quien la tocó al final, tal como se llamaba entonces.
  ///
  /// Junto al id y no en su lugar: el id sirve para filtrar por persona, pero
  /// se queda sin dueño si la cuenta se elimina, y si alguien se cambia el
  /// apellido no corresponde reescribir lo que ya pasó. El texto es lo que se
  /// muestra; el id, lo que se consulta.
  updatedByNombre String?
  /// Cuándo se cerró como completada, y quién apretó el botón.
  ///
  /// No es `fechaRealizada`: esa es el **día en que se hizo el trabajo**, la
  /// elige quien la cierra y puede ser anterior —el lunes se cierra una visita
  /// hecha el viernes—. Esto es el instante en que quedó registrada.
  ///
  /// Y no es `updatedById`: ese es el último que la tocó por cualquier motivo,
  /// así que una corrección de fecha tres semanas después borra el rastro de
  /// quién la completó. Por eso son campos aparte.
  ///
  /// Se ponen al pasar a COMPLETADA y se limpian si sale de ese estado: si la
  /// visita ya no está completada, no hay nadie que la haya completado.
  completadaEl        DateTime?
  completadaPorId     String?
  /// El nombre de quien la completó, congelado en ese momento. Ver
  /// `updatedByNombre`: mismo motivo.
  completadaPorNombre String?

  cliente        Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  productos      VisitaProducto[]
  grupo          Grupo?            @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  createdBy      User?             @relation("VisitaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?             @relation("VisitaUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  completadaPor  User?             @relation("VisitaCompletadaPor", fields: [completadaPorId], references: [id], onDelete: SetNull)
  media          VisitaMedia[]
  personal       VisitaPersonal[]
  notificaciones NotificacionLog[]
  messages       VisitaMessage[]
  chatReads      VisitaChatRead[]
  informes       InformeVisita[]
  ordenes        OrdenVisita[]
  suscripcion    Suscripcion?      @relation(fields: [suscripcionId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([suscripcionId])
  @@index([fechaProgramada])
  /// Para filtrar "completadas entre estas fechas" sin recorrer la tabla.
  @@index([completadaEl])
}

/// Una visita puede cubrir varios servicios contratados del mismo cliente.
/// Un producto cubierto por una visita. Una visita puede cubrir varios.
///
/// **No lleva plata.** El precio de un trabajo se decide al facturarlo, en la
/// orden, igual que todo el resto del dinero del sistema. Acá solo vive el
/// hecho: qué se hizo y si estaba cubierto por un plan.
model VisitaProducto {
  id                String  @id @default(cuid())
  visitaId          String
  /// Qué se hizo. Siempre presente, venga de una suscripción o sea trabajo suelto.
  productoId        String
  /// Puesto = el plan lo cubre y no se cobra aparte. Null = trabajo suelto, se
  /// factura creando una orden. No es plata: es cobertura.
  suscripcionItemId String?
  /// En qué lugar de la lista va, nada más. Se llamaba `orden` y se leía como
  /// "a qué orden pertenece", que es justo lo que **no** es: eso vive en
  /// `OrdenLinea.visitaProductoId`. `OrdenLinea` ya usaba `posicion` para lo
  /// mismo.
  posicion          Int     @default(0)
  /// Cuándo se soltó de una orden anulada.
  ///
  /// Anular libera la procedencia, así que el trabajo vuelve a "pendiente" y no
  /// queda ni rastro de que alguna vez estuvo facturado. Sin esta marca, el
  /// proceso que arma borradores lo volvería a agarrar y pisaría la decisión de
  /// no cobrarlo. Facturarlo a mano sigue siendo posible: esto solo frena a los
  /// automatismos.
  liberadoAt        DateTime?

  visita          Visita           @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  producto        Producto         @relation(fields: [productoId], references: [id], onDelete: Restrict)
  suscripcionItem SuscripcionItem? @relation(fields: [suscripcionItemId], references: [id], onDelete: SetNull)
  /// Dónde se cobró, si ya se cobró. El id es único en `OrdenLineaOrigen`, así
  /// que esto es a lo sumo uno: un trabajo se factura una sola vez.
  ordenLineaOrigen OrdenLineaOrigen?

  @@unique([visitaId, productoId])
  @@index([productoId])
  @@index([suscripcionItemId])
}

model VisitaPersonal {
  id          String    @id @default(cuid())
  visitaId    String
  personalId  String
  addedAt     DateTime  @default(now())
  addedById   String?
  removedAt   DateTime?
  removedById String?

  visita    Visita   @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  personal  Personal @relation(fields: [personalId], references: [id], onDelete: Cascade)
  addedBy   User?    @relation("VisitaPersonalAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  removedBy User?    @relation("VisitaPersonalRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)

  @@unique([visitaId, personalId])
}

model VisitaMedia {
  id        String   @id @default(cuid())
  visitaId  String
  key       String
  url       String
  tipo      String
  createdAt DateTime @default(now())

  /// Etiqueta opcional: a cuál de los productos de la visita corresponde la foto.
  productoId String?

  visita       Visita               @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  producto     Producto?            @relation(fields: [productoId], references: [id], onDelete: SetNull)
  informeFotos InformeSeccionFoto[]

  @@index([visitaId])
  @@index([productoId])
}

model VisitaMessage {
  id           String   @id @default(cuid())
  visitaId     String
  authorUserId String
  body         String?  @db.Text
  createdAt    DateTime @default(now())

  visita Visita               @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  author User                 @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  media  VisitaMessageMedia[]

  @@index([visitaId, createdAt])
  @@index([authorUserId])
}

model VisitaMessageMedia {
  id        String   @id @default(cuid())
  messageId String
  key       String
  url       String
  tipo      String
  createdAt DateTime @default(now())

  message VisitaMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model VisitaChatRead {
  visitaId   String
  userId     String
  lastReadAt DateTime @default(now()) @updatedAt

  visita Visita @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([visitaId, userId])
  @@index([userId, lastReadAt])
}

model GrupoMiembro {
  id         String @id @default(cuid())
  personalId String
  grupoId    String

  personal Personal @relation(fields: [personalId], references: [id], onDelete: Cascade)
  grupo    Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@unique([personalId, grupoId])
}

model Sector {
  id        String    @id @default(cuid())
  nombre    String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  clientes Cliente[]
  admins   SectorAdmin[]
}

model SectorAdmin {
  id       String @id @default(cuid())
  sectorId String
  userId   String

  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sectorId, userId])
}

// ──────────────────────────────────────────────
// Notificaciones WhatsApp
// ──────────────────────────────────────────────

model NotificacionConfig {
  id                     String   @id @default(cuid())
  whatsappActivo         Boolean  @default(false)
  whatsappPhoneNumberId  String?
  whatsappBusinessId     String?
  horaEnvioRecordatorio  String   @default("08:00")
  horaEnvioDigesto       String   @default("07:00")
  diasAnticipacion       Int      @default(1)
  zonaHoraria            String   @default("America/Guayaquil")
  autoRespuestaActiva    Boolean  @default(false)
  autoRespuestaContenido String?  @db.Text
  forwardActivo          Boolean  @default(false)
  forwardTelefono        String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model NotificacionPlantilla {
  id                            String           @id @default(cuid())
  tipo                          TipoNotificacion @unique
  nombre                        String
  activa                        Boolean          @default(true)
  // Template default (original, fijo en Meta)
  contenidoOriginal             String?          @db.Text
  whatsappDefaultTemplateName   String?
  whatsappDefaultTemplateStatus String?
  // Template personalizado (custom, editable)
  whatsappTemplateName          String?
  whatsappTemplateStatus        String?
  whatsappTemplateVersion       Int              @default(1)
  whatsappTemplateLanguage      String           @default("es")
  whatsappPendingTemplateName   String?
  whatsappPendingTemplateStatus String?
  contenido                     String           @db.Text
  contenidoEnRevision           String?          @db.Text
  variables                     String[]
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt
}

model NotificacionLog {
  id                 String             @id @default(cuid())
  tipo               TipoNotificacion
  destinatarioTipo   DestinatarioTipo
  destinatarioId     String?
  destinatarioNombre String?
  telefono           String
  mensaje            String             @db.Text
  estado             EstadoNotificacion @default(PENDIENTE)
  whatsappMessageId  String?
  errorDetalle       String?            @db.Text
  visitaId           String?
  enviadoAt          DateTime?
  createdAt          DateTime           @default(now())

  visita Visita? @relation(fields: [visitaId], references: [id], onDelete: SetNull)
}

// ──────────────────────────────────────────────
// Mobile auth / push
// ──────────────────────────────────────────────

model PushToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String
  deviceName String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  deviceInfo String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Historial de importaciones masivas de clientes (CSV). `results` guarda el
// detalle por fila (ImportRowResult[]): fila, estado, nombre, clienteId, mensaje.
model ClienteImport {
  id          String   @id @default(cuid())
  createdById String?
  createdBy   User?    @relation("ClienteImportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // "procesando" | "completado" | "cancelado"
  status      String   @default("procesando")
  total       Int
  created     Int      @default(0)
  skipped     Int      @default(0)
  failed      Int      @default(0)
  results     Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

/// Token de un solo uso para establecer una contraseña: la invitación de un
/// usuario del portal, la de un cliente, o el restablecimiento de cualquiera de
/// los dos. Solo se guarda el hash (sha256): el token en claro existe una vez,
/// dentro del enlace, y ni siquiera nosotros podemos volver a leerlo.
///
/// Apunta a **un** cliente o a **un** usuario, nunca a los dos ni a ninguno
/// (un CHECK lo obliga). Son dos tablas de identidad distintas —el personal
/// vive en User, los clientes en Cliente— pero el enlace, la página y el
/// vencimiento son los mismos, y partirlo en dos tablas habría significado
/// duplicar todo eso para variar solo la clave foránea.
model SetPasswordToken {
  id        String    @id @default(cuid())
  clienteId String?
  userId    String?
  tokenHash String    @unique
  expiresAt DateTime
  /// Cuándo alguien lo abrió y eligió una contraseña. Solo eso.
  usedAt    DateTime?
  /// Cuándo lo dimos de baja nosotros: porque se emitió uno más nuevo, o
  /// porque se le revocó el acceso a la persona.
  ///
  /// Aparte de `usedAt` porque no son lo mismo y la diferencia se ve: decirle
  /// "este enlace ya se usó" a quien nunca lo abrió lo manda a preguntarse
  /// quién entró con él.
  anuladoEl DateTime?
  createdAt DateTime  @default(now())

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([userId])
}

// ──────────────────────────────────────────────
// Informes mensuales (PDFs)
// ──────────────────────────────────────────────

model Informe {
  id            String    @id @default(cuid())
  clienteId     String
  /// Correlativo corto, para nombrarlo en voz alta. Como el de visitas y
  /// órdenes: cada tabla tiene su propia secuencia y eso está bien, porque
  /// nunca se muestra un número sin decir de qué es.
  numero        Int       @unique @default(autoincrement())
  titulo        String
  /// La fecha que **sale impresa** en el PDF, y solo eso.
  ///
  /// Va aparte de `generatedAt` porque son dos hechos distintos: cuándo se
  /// armó el archivo y con qué fecha se entrega. Un informe de agosto se puede
  /// generar el 2 de septiembre y tiene que decir agosto; y regenerarlo para
  /// corregir una foto no puede cambiarle la fecha al documento que el cliente
  /// ya tiene. `generatedAt` sigue siendo el instante real, para auditoría.
  fecha         DateTime  @db.Date
  fechaDesde    DateTime?
  fechaHasta    DateTime?
  pdfKey        String
  pdfUrl        String
  // Per-informe signers: [{ nombre: string, cedula?: string }]. 1 to 3.
  firmantes     Json      @default("[]")
  generatedById String
  generatedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cliente     Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  generatedBy User             @relation("InformeGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  visitas     InformeVisita[]
  secciones   InformeSeccion[]

  @@index([clienteId])
  @@index([generatedAt])
}

model InformeVisita {
  informeId String
  visitaId  String

  informe Informe @relation(fields: [informeId], references: [id], onDelete: Cascade)
  visita  Visita  @relation(fields: [visitaId], references: [id], onDelete: Cascade)

  @@id([informeId, visitaId])
  @@index([visitaId])
}

model InformeSeccion {
  id          String  @id @default(cuid())
  informeId   String
  /// Producto que origina la sección. Null = sección personalizada.
  productoId  String?
  titulo      String
  descripcion String? @db.Text
  orden       Int

  informe  Informe              @relation(fields: [informeId], references: [id], onDelete: Cascade)
  producto Producto?            @relation(fields: [productoId], references: [id], onDelete: SetNull)
  fotos    InformeSeccionFoto[]

  @@index([informeId])
  @@index([productoId])
}

/// Una foto de una sección: puede venir de una visita (visitaMediaId) o haber
/// sido subida directamente al informe. `key`/`url` siempre se guardan para que
/// el informe siga siendo editable aunque se borre la media de la visita.
model InformeSeccionFoto {
  id            String  @id @default(cuid())
  seccionId     String
  orden         Int
  key           String
  url           String
  visitaMediaId String?

  seccion     InformeSeccion @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  visitaMedia VisitaMedia?   @relation(fields: [visitaMediaId], references: [id], onDelete: SetNull)

  @@index([seccionId, orden])
  @@index([visitaMediaId])
}

model EmpresaConfig {
  id        String   @id @default("default")
  nombre    String?
  logoKey   String?
  logoUrl   String?
  updatedAt DateTime @updatedAt
}

model Firmante {
  id        String   @id @default(cuid())
  nombre    String
  cedula    String?
  isDefault Boolean  @default(false)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault])
}

// ──────────────────────────────────────────────
// Libro de ventas
//
// Una orden es "lo que se vendió": existe desde que se hizo el trabajo, antes
// de que exista factura. Toda la plata vive en `OrdenLinea`, venga de una
// suscripción, de una visita única o (más adelante) de un bien. Así un reporte
// de ventas es una sola consulta en vez de un union por cada tipo de ingreso,
// y si algún día se deja de usar Contífico el historial completo queda acá.
// ──────────────────────────────────────────────

/// Tres estados y una sola idea: si la orden está viva y si se puede tocar.
///
/// No hay FACTURADA porque facturar dejó de ser un paso aparte —confirmar
/// emite— así que CONFIRMADA **es** "tiene factura viva". Que esté cobrada o no
/// se lee del saldo de esa factura, no del estado de la orden: son dos ejes
/// distintos y mezclarlos obligaba a inventar un estado por combinación.
///
/// Una emisión fallida deja la orden en BORRADOR, que es el único estado
/// editable: justo donde hay que estar para arreglar la causa.
enum EstadoOrden {
  BORRADOR
  CONFIRMADA
  ANULADA
}

model Orden {
  id                String      @id @default(cuid())
  clienteId         String
  /// Con qué datos se va a facturar. Se elige al armar la orden, cuando el
  /// vendedor tiene al cliente delante; al emitir ya es tarde para preguntar.
  /// Nullable porque una orden puede existir antes de saberlo.
  datoFacturacionId String?
  /// Correlativo interno legible. No es el número de factura del SRI.
  numero            Int         @unique @default(autoincrement())

  /// De qué plan es esta orden, cuando es de un plan.
  ///
  /// Las visitas viven en `OrdenVisita` porque pueden ser **varias**; un plan
  /// no: sus períodos se renuevan solos y cada orden cubre uno.
  ///
  /// Null y sin `OrdenVisita` = orden suelta, armada a mano.
  suscripcionId     String?
  fecha             DateTime    @db.Date
  estado            EstadoOrden @default(BORRADOR)
  notas             String?     @db.Text

  /// Totales denormalizados, recalculados desde las líneas en cada escritura.
  subtotal Decimal @default(0) @db.Decimal(10, 2)
  iva      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @default(0) @db.Decimal(10, 2)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  cliente         Cliente          @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  datoFacturacion DatoFacturacion? @relation(fields: [datoFacturacionId], references: [id], onDelete: SetNull)
  suscripcion     Suscripcion?     @relation(fields: [suscripcionId], references: [id], onDelete: Restrict)
  createdBy       User?            @relation("OrdenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?            @relation("OrdenUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  lineas          OrdenLinea[]
  facturas        Factura[]
  visitas         OrdenVisita[]

  @@index([clienteId, fecha])
  @@index([estado])
  @@index([datoFacturacionId])
  @@index([suscripcionId])
}

/// De qué visitas es una orden.
///
/// Es una lista y no una columna porque **una orden puede cubrir varias
/// visitas**: es normal cobrar el mes entero de alguien de una vez. Lo mantiene
/// el servidor desde la procedencia de las líneas, así que no se recibe de
/// afuera — una asignación que no trajera trabajo sería una que no queda
/// registrada en ningún lado.
///
/// Existe además de `OrdenLineaOrigen` porque contesta otra pregunta: aquélla
/// dice de dónde sale cada peso, ésta "¿de qué es esta orden?", que es la que
/// se hace primero y la que obligaba a recorrer las líneas.
model OrdenVisita {
  ordenId  String
  visitaId String

  orden  Orden  @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  /// `Restrict`: una visita con orden no se borra sin resolver la orden antes.
  visita Visita @relation(fields: [visitaId], references: [id], onDelete: Restrict)

  @@id([ordenId, visitaId])
  @@index([visitaId])
}

model OrdenLinea {
  id       String @id @default(cuid())
  ordenId  String
  posicion Int    @default(0)

  /// Snapshot: sobrevive a que después renombren o borren el producto.
  descripcion    String
  cantidad       Decimal @default(1) @db.Decimal(10, 2)
  precioUnitario Decimal @db.Decimal(10, 2)
  ivaTasa        Decimal @default(0) @db.Decimal(5, 2)
  subtotal       Decimal @db.Decimal(10, 2)
  iva            Decimal @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  /// Qué se vendió. Obligatorio: Contífico exige `producto_id` en cada línea y
  /// no acepta texto libre, así que una línea sin producto sería una venta que
  /// no se puede cobrar. Es además lo que hace que un reporte por producto sea
  /// un `groupBy` y no una reconstrucción.
  productoId        String
  suscripcionItemId String?
  periodoInicio     DateTime? @db.Date
  periodoFin        DateTime? @db.Date

  orden           Orden            @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  /// `Restrict` y no `SetNull`: un producto que ya se vendió no se puede
  /// borrar. Perder el vínculo dejaría la línea fuera de todo reporte y la
  /// factura sin con qué reconciliarse.
  producto        Producto         @relation(fields: [productoId], references: [id], onDelete: Restrict)
  suscripcionItem SuscripcionItem? @relation(fields: [suscripcionItemId], references: [id], onDelete: SetNull)
  /// De qué trabajos de visita sale esta línea. Pueden ser varios.
  origenes        OrdenLineaOrigen[]

  /// Impide facturar dos veces el mismo período de la misma suscripción.
  @@unique([suscripcionItemId, periodoInicio])
  @@index([ordenId, posicion])
  @@index([productoId])
}

/// Qué trabajo de qué visita paga una línea de orden.
///
/// Era una columna única en `OrdenLinea`, y eso obligaba a una línea por
/// visita: el mismo producto hecho en dos visitas salía dos veces en la misma
/// orden, lo que no le dice nada a nadie —es el mismo producto— y encima
/// duplicaba la decisión de precio. Ahora una línea junta los dos trabajos.
///
/// `visitaProductoId` sigue siendo **único en toda la tabla**: eso es lo que
/// impide cobrar el mismo trabajo dos veces, y no depende de ninguna
/// validación de aplicación.
model OrdenLineaOrigen {
  ordenLineaId     String
  visitaProductoId String @unique

  ordenLinea     OrdenLinea     @relation(fields: [ordenLineaId], references: [id], onDelete: Cascade)
  /// `Restrict`: el trabajo facturado no se borra. Como `VisitaProducto`
  /// cascadea desde `Visita`, esto también protege a la visita entera.
  visitaProducto VisitaProducto @relation(fields: [visitaProductoId], references: [id], onDelete: Restrict)

  @@id([ordenLineaId, visitaProductoId])
  @@index([ordenLineaId])
}

enum EstadoFactura {
  PENDIENTE
  FIRMADO
  ENVIADO_SRI
  AUTORIZADO
  RECHAZADO
}

/// Qué documento se emite en Contífico por una orden.
///
/// `NO_AUTORIZADO` es el `DNA` de Contífico: un documento interno, para el
/// cliente que no pide comprobante. Se crea, se cobra y se anula igual que una
/// factura, pero **nunca toca el SRI** —no tiene autorización, ni XML, ni
/// RIDE— y **no admite IVA**: Contífico rechaza cualquier impuesto en un DNA
/// (`400 · 1016`). Tampoco valida su numeración, así que la unicidad la pone
/// el portal.
enum TipoDocumento {
  FACTURA
  NO_AUTORIZADO
}

/// Espejo de la factura que vive en Contífico. El portal no la emite ni la
/// numera: guarda la referencia y el estado. Contífico no permite editarlas ni
/// anularlas por API, así que acá son de solo lectura una vez creadas.
/// Los datos con los que se le emite una factura a un cliente.
///
/// Van aparte del Cliente porque uno puede facturar de más de una forma: a
/// nombre propio y al de su empresa, o a distintas razones sociales de un mismo
/// contacto. Y porque el nombre con el que se lo conoce en el portal no tiene
/// por qué ser la razón social del SRI.
///
/// Editarlo no rompe el historial: cada Factura guarda además un snapshot de la
/// razón social e identificación con las que se emitió.
model DatoFacturacion {
  id        String @id @default(cuid())
  clienteId String

  /// `CEDULA` o `RUC`. Contífico valida el módulo 10 de la cédula.
  tipoIdentificacion TipoIdentificacion
  identificacion     String
  /// Lo que se imprime en la factura, no el nombre del portal.
  razonSocial        String
  /// Natural o jurídica: Contífico lo recibe como `N` / `J`.
  tipoPersona        TipoPersona
  direccion          String?
  telefono           String?
  email              String?

  /// El que se propone al facturar.
  esPredeterminado Boolean @default(false)
  /// Los archivados no se ofrecen, pero las facturas viejas los siguen citando.
  archivado        Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("DatoFacturacionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?     @relation("DatoFacturacionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  facturas  Factura[]
  ordenes   Orden[]

  /// No se repite la misma identificación dos veces en el mismo cliente.
  @@unique([clienteId, identificacion])
  @@index([clienteId, archivado])
}

enum TipoIdentificacion {
  CEDULA
  RUC
}

model Factura {
  id      String @id @default(cuid())
  ordenId String

  contificoDocumentoId String?       @unique
  /// Único porque en un `NO_AUTORIZADO` **nadie más lo garantiza**: Contífico
  /// acepta un número repetido y crea un segundo documento, al revés que en
  /// una factura. Las dos series no se pisan: `001-002-000000123` contra
  /// `VF-000000001`.
  numero               String        @unique
  tipo                 TipoDocumento @default(FACTURA)
  fechaEmision         DateTime      @db.Date
  /// Lo que sale impreso en *Información Adicional*. Es el único texto libre
  /// del documento: el nombre de cada línea lo decide el producto de Contífico.
  descripcion          String?
  estado               EstadoFactura @default(PENDIENTE)
  /// Clave de acceso del SRI (49 dígitos), la genera Contífico.
  autorizacion         String?
  urlRide              String?
  urlXml               String?
  /// Persona de Contífico. La crea sola al facturar; se guarda por referencia.
  contificoPersonaId   String?

  /// Con qué datos se emitió. El id es la referencia; los dos campos de abajo
  /// son el snapshot y son la verdad — el dato puede editarse o archivarse, y
  /// el papel que recibió el cliente no cambia.
  datoFacturacionId String?
  razonSocial       String?
  identificacion    String?

  subtotal0       Decimal @default(0) @db.Decimal(10, 2)
  subtotalGravado Decimal @default(0) @db.Decimal(10, 2)
  iva             Decimal @default(0) @db.Decimal(10, 2)
  total           Decimal @default(0) @db.Decimal(10, 2)
  /// Lo que falta cobrar, espejado de Contífico. Los cobros son suyos: acá solo
  /// se guarda el número para no tener que pedirlo cada vez. `null` = sin
  /// sincronizar todavía.
  saldo           Decimal? @db.Decimal(10, 2)

  anulada   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orden           Orden            @relation(fields: [ordenId], references: [id], onDelete: Restrict)
  datoFacturacion DatoFacturacion? @relation(fields: [datoFacturacionId], references: [id], onDelete: SetNull)
  lineas          FacturaLinea[]

  @@index([ordenId])
  @@index([estado])
}

/// Lo que salió impreso en el documento, línea por línea.
///
/// Existe porque la factura **puede no tener la forma de la orden**: lo normal
/// acá es cobrar varios trabajos de un período como una sola línea de
/// "servicio de mantenimiento". Mientras las dos formas eran la misma, la
/// factura se podía reconstruir desde la orden; en cuanto pueden diferir, esa
/// reconstrucción es una mentira sobre un documento que ya se entregó.
///
/// No hay puente hacia `OrdenLinea` a propósito: la procedencia de cada peso
/// —qué visita, qué período— vive en la orden, que es el libro de ventas. Esto
/// es el espejo de lo legal. Lo que ata las dos caras es que **cuadren**: misma
/// base imponible por cada tasa.
model FacturaLinea {
  id        String @id @default(cuid())
  facturaId String
  posicion  Int    @default(0)

  /// Snapshot del nombre que Contífico imprimió, que es el de **su** producto.
  descripcion    String
  /// Acompaña al nombre en el papel: viaja como `nombre_manual` y sale en el
  /// RIDE como "Detalle: …". **No lo reemplaza** — eso la API no lo permite.
  detalle        String?
  cantidad       Decimal @default(1) @db.Decimal(10, 2)
  precioUnitario Decimal @db.Decimal(10, 2)
  ivaTasa        Decimal @default(0) @db.Decimal(5, 2)
  subtotal       Decimal @db.Decimal(10, 2)
  iva            Decimal @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  /// Obligatorio: `detalles[].producto_id` es lo único que Contífico acepta.
  /// No hay líneas de texto libre ni líneas contables — verificado agotando
  /// las variantes contra su API.
  productoId String

  factura  Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  /// `Restrict` como en `OrdenLinea`: un producto ya facturado no se borra, o
  /// la factura se queda sin con qué reconciliarse.
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@index([facturaId, posicion])
  @@index([productoId])
}
