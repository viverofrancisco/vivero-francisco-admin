generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// NextAuth models
// ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum UserRole {
  ADMIN
  STAFF
  PERSONAL_ADMIN
  PERSONAL
  CLIENTE
}

/// Si el producto está listo para venderse.
///
/// `BORRADOR` es el que todavía se está armando: existe, se le cargan fotos y
/// variantes, pero **no aparece en los selectores** de una orden. Es lo que
/// evita que algo a medio configurar —sin precio, sin SKU— termine en una
/// factura por estar en la lista.
///
/// Archivado es otra cosa y vive en `deletedAt`: un borrador nunca se vendió;
/// un archivado se vendía y dejó de ofrecerse.
enum EstadoProducto {
  ACTIVO
  BORRADOR
}

/// Qué es el ítem: algo que se ejecuta o algo que se despacha.
///
/// **No cambia nada al facturar.** El `<detalle>` del SRI no distingue bienes
/// de servicios: lleva código, descripción, cantidad, precio e impuestos, y
/// nada sobre la naturaleza de lo vendido. Era una distinción contable de
/// Contífico (`SER` / `PRO`), que decidía qué lleva inventario y en qué cuenta
/// caía la venta.
///
/// Se queda porque es la clasificación del catálogo —agrupa y filtra la
/// lista— y porque es exactamente el eje que va a decidir qué tiene stock el
/// día que el inventario se lleve acá.
enum TipoProducto {
  SERVICIO
  BIEN
}

/// Cómo se vende. Vive solo en el portal: al SRI le llega una factura por
/// período, no el contrato que la generó.
/// Cada cuánto se cobra una suscripción. El precio del contrato es por período,
/// no por mes: una anual de $1200 se cobra $1200 una vez al año.
enum Periodicidad {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

/// Tipo de persona para facturación.
enum TipoPersona {
  NATURAL
  JURIDICA
}

enum EstadoServicio {
  ACTIVO
  PAUSADO
  CANCELADO
}

enum EstadoVisita {
  PROGRAMADA
  COMPLETADA
  INCOMPLETA
  CANCELADA
}

enum TipoNotificacion {
  RECORDATORIO_VISITA_CLIENTE
  CONFIRMACION_VISITA_CLIENTE
  RESUMEN_DIARIO_ADMIN
  ALERTA_VISITA_COMPLETADA
  ALERTA_VISITA_INCOMPLETA
  MENSAJE_ENTRANTE_CLIENTE
  AUTENTICACION_OTP
  INVITACION_CUENTA
}

enum EstadoNotificacion {
  PENDIENTE
  ENVIADA
  FALLIDA
}

enum DestinatarioTipo {
  CLIENTE
  ADMIN
  PERSONAL
}

// ──────────────────────────────────────────────
// Application models
// ──────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  name             String?
  apellido         String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  role             UserRole  @default(STAFF)
  /// Cuándo se le revocó el acceso, o null si lo tiene.
  ///
  /// Una fecha y no un booleano: cuando alguien pregunta "¿desde cuándo no
  /// entra?" la respuesta ya está guardada. Revocar no borra la cuenta —su
  /// nombre sigue firmando las visitas e informes que hizo— solo cierra la
  /// puerta: los dos caminos de login la rechazan, sus enlaces pendientes se
  /// anulan y sus sesiones móviles dejan de renovarse.
  accesoRevocadoEl DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  /// Enlaces de invitación / restablecimiento pendientes o ya usados.
  setPasswordTokens SetPasswordToken[]

  // Audit relations
  clientesCreated         Cliente[]              @relation("ClienteCreatedBy")
  clientesUpdated         Cliente[]              @relation("ClienteUpdatedBy")
  media                   Media[]                @relation("MediaCreatedBy")
  productosCreated        Producto[]             @relation("ProductoCreatedBy")
  productosUpdated        Producto[]             @relation("ProductoUpdatedBy")
  movimientosInventario   MovimientoInventario[] @relation("MovimientoCreatedBy")
  cobrosRegistrados       Cobro[]                @relation("CobroCreatedBy")
  personalCreated         Personal[]             @relation("JardineroCreatedBy")
  personalUpdated         Personal[]             @relation("JardineroUpdatedBy")
  gruposCreated           Grupo[]                @relation("GrupoCreatedBy")
  gruposUpdated           Grupo[]                @relation("GrupoUpdatedBy")
  suscripcionesCreated    Suscripcion[]          @relation("SuscripcionCreatedBy")
  suscripcionesUpdated    Suscripcion[]          @relation("SuscripcionUpdatedBy")
  visitasCreated          Visita[]               @relation("VisitaCreatedBy")
  visitasUpdated          Visita[]               @relation("VisitaUpdatedBy")
  visitasCompletadas      Visita[]               @relation("VisitaCompletadaPor")
  visitaPersonalAdded     VisitaPersonal[]       @relation("VisitaPersonalAddedBy")
  visitaPersonalRemoved   VisitaPersonal[]       @relation("VisitaPersonalRemovedBy")
  personal                Personal?
  sectorAdmins            SectorAdmin[]
  cliente                 Cliente?
  pushTokens              PushToken[]
  refreshTokens           RefreshToken[]
  visitaMessages          VisitaMessage[]
  visitaChatReads         VisitaChatRead[]
  informesGenerados       Informe[]              @relation("InformeGeneratedBy")
  informesActualizados    Informe[]              @relation("InformeUpdatedBy")
  informeVersiones        InformeVersion[]       @relation("InformeVersionGeneratedBy")
  informeBorradoresCreados     InformeBorrador[] @relation("InformeBorradorCreatedBy")
  informeBorradoresActualizados InformeBorrador[] @relation("InformeBorradorUpdatedBy")
  clienteImports          ClienteImport[]        @relation("ClienteImportCreatedBy")
  ordenesCreated          Orden[]                @relation("OrdenCreatedBy")
  ordenesUpdated          Orden[]                @relation("OrdenUpdatedBy")
  datosFacturacionCreated DatoFacturacion[]      @relation("DatoFacturacionCreatedBy")
  datosFacturacionUpdated DatoFacturacion[]      @relation("DatoFacturacionUpdatedBy")
}

model Cliente {
  id              String  @id @default(cuid())
  nombre          String
  apellido        String?
  empresa         String?
  email           String?
  telefono        String?
  ciudad          String?
  sectorId        String?
  direccion       String?
  numeroCasa      String?
  referencia      String? @db.Text
  notas           String? @db.Text
  metrosCuadrados Float?

  /// Identificación tributaria del contacto. Lo que sale impreso en una
  /// factura no es esto sino `DatoFacturacion`, que puede haber varios.
  cedula      String?
  ruc         String?
  tipoPersona TipoPersona?

  recibirRecordatorios  Boolean   @default(true)
  recibirConfirmaciones Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  createdById String?
  updatedById String?
  userId      String? @unique
  createdBy   User?   @relation("ClienteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("ClienteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  sector            Sector?            @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  suscripciones     Suscripcion[]
  datosFacturacion  DatoFacturacion[]
  visitas           Visita[]
  ordenes           Orden[]
  informes          Informe[]
  informeBorradores InformeBorrador[]
  setPasswordTokens SetPasswordToken[]
}

/// Catálogo único: servicios de jardinería y, más adelante, bienes de vivero.
/// Lo que los distingue es `tipo`, que no cambia nada al facturar.
model Producto {
  id          String       @id @default(cuid())
  nombre      String
  descripcion String?      @db.Text
  /// Inmutable después de crear: cambiarlo dejaría líneas de orden con una
  /// semántica que ya no corresponde. No hay un eje "único vs recurrente" en el
  /// catálogo: lo recurrente lo define la suscripción que contiene al producto,
  /// no el producto.
  tipo        TipoProducto @default(SERVICIO)

  /// Si ya se puede vender. Un `BORRADOR` no aparece en los selectores.
  estado EstadoProducto @default(ACTIVO)

  /// Tasa de IVA por defecto (porcentaje). En Ecuador conviven 0% y 15%.
  ivaTasa Decimal? @db.Decimal(5, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  updatedById String?
  createdBy   User?   @relation("ProductoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("ProductoUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  suscripcionItems SuscripcionItem[]
  visitaProductos  VisitaProducto[]
  visitaMedia      VisitaMedia[]
  informeSecciones InformeSeccion[]
  ordenLineas      OrdenLinea[]
  facturaLineas    FacturaLinea[]

  /// Un producto puede estar en varias: "Plantas" y "Interior" a la vez.
  categorias ProductoCategoria[]
  opciones   OpcionProducto[]
  variantes  Variante[]
  imagenes   ProductoImagen[]
}

/// Cómo se agrupa el catálogo: lo que sirve para encontrar un producto en una
/// lista. No sale impresa en la factura ni cambia cómo se emite.
model Categoria {
  id     String @id @default(cuid())
  nombre String @unique
  /// Para ordenar la lista a mano; a igual orden, alfabético.
  orden  Int    @default(0)

  /// De qué se trata, con formato. Es HTML de un editor y se sanea al guardar.
  descripcion String? @db.Text

  /// La foto que la representa. Sale de la biblioteca, igual que las de un
  /// producto: la misma imagen puede ser la de la categoría y la de su
  /// producto estrella sin subirla dos veces.
  mediaId String?
  media   Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productos ProductoCategoria[]

  @@index([mediaId])
}

/// En qué categorías está un producto.
///
/// Era una columna en `Producto`, o sea una sola categoría. Pero un rosal es
/// "Plantas" y también "Exterior", y con un solo casillero había que elegir
/// cuál de las dos verdades guardar. Borrar la categoría se lleva la fila, no
/// el producto: dejar de agrupar algo no es darlo de baja.
model ProductoCategoria {
  productoId  String
  categoriaId String
  /// El orden a mano dentro de la categoría. Es **el orden guardado**: los
  /// demás —por nombre, por precio— son formas de mirar la lista y no se
  /// guardan, porque sin vidriera que los consuma serían una columna que nadie
  /// lee.
  posicion    Int    @default(0)

  producto  Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@id([productoId, categoriaId])
  @@index([categoriaId, posicion])
}

/// ── Variantes e inventario ────────────────────────────────────────────────
///
/// Un eje por el que un bien se divide: Color, Tamaño, Material.
///
/// **Solo los bienes.** Lo que cambia de una poda a otra es el precio, y eso
/// vive en la orden: un servicio no tiene nada que combinar ni que contar.
model OpcionProducto {
  id         String @id @default(cuid())
  productoId String
  /// "Color", "Tamaño".
  nombre     String
  /// Para ordenar los ejes. Es también el orden en que se lee una variante:
  /// "Rojo · Grande" y no "Grande · Rojo".
  posicion   Int    @default(0)

  producto Producto      @relation(fields: [productoId], references: [id], onDelete: Cascade)
  valores  ValorOpcion[]

  @@unique([productoId, nombre])
  @@index([productoId])
}

/// Un valor de un eje: "Rojo", "Grande".
model ValorOpcion {
  id       String @id @default(cuid())
  opcionId String
  valor    String
  posicion Int    @default(0)

  opcion    OpcionProducto  @relation(fields: [opcionId], references: [id], onDelete: Cascade)
  variantes VarianteValor[]

  @@unique([opcionId, valor])
  @@index([opcionId])
}

/// Una combinación concreta de valores: "Rojo · Grande".
///
/// Es lo que se cuenta. Un bien **sin ninguna opción tiene una variante
/// igual**, sin valores: así todo lo que pregunta "cuánto hay" mira siempre al
/// mismo lado, haya opciones o no, y no hay dos caminos que mantener.
model Variante {
  id         String @id @default(cuid())
  productoId String

  /// **Precio de lista.** Es lo que se propone al armar una orden, no lo que se
  /// cobró: eso vive en `OrdenLinea.precioUnitario`, que es un snapshot y sigue
  /// siendo la verdad. Cambiar este precio no reescribe nada de lo ya vendido —
  /// que es justamente el punto de tenerlos separados.
  ///
  /// Obligatorio, y **cero quiere decir gratis**: toda variante tiene un
  /// precio, aunque sea ninguno. Una recién creada nace en cero, así que la
  /// lista muestra ese caso como "Gratis" — bien visible, porque casi siempre
  /// significa que todavía nadie le puso precio.
  precio Decimal @default(0) @db.Decimal(10, 2)

  /// El identificador de esta variante: lo que va en la etiqueta y lo que se
  /// busca. Único en todo el catálogo — dos variantes con el mismo SKU harían
  /// ambiguo cualquier conteo.
  sku      String? @unique
  posicion Int     @default(0)

  /// La combinación, congelada: los ids de sus valores ordenados y unidos por
  /// "·". Es lo que le permite a la base garantizar que un producto no tenga
  /// dos variantes iguales; con la tabla puente sola eso no se puede expresar.
  /// Vacía en la variante única de un producto sin opciones.
  combinacion String @default("")

  /// **Si se le cobra IVA.** El *cuánto* sigue siendo del producto
  /// (`Producto.ivaTasa`): en Ecuador conviven 0% y 15%, y la tasa es del
  /// bien, no de su color. Esto es el interruptor — apagado, la línea se
  /// propone al 0% aunque el producto tenga tasa.
  ///
  /// Por variante y no por producto porque hay bienes cuyo gravamen depende de
  /// la presentación: el mismo abono a granel y fraccionado no siempre tributan
  /// igual. Y como todo lo demás, es una **propuesta**: la tasa que se cobró
  /// queda en `OrdenLinea.ivaTasa`, donde se puede cambiar.
  cobraIva Boolean @default(true)

  /// Si lleva stock. Una planta se cuenta; la tierra a granel puede que no.
  manejaInventario Boolean @default(true)
  /// Cuánto hay. Lo mantiene `MovimientoInventario` y **nunca se escribe
  /// suelto**: es el saldo del libro, no una segunda fuente de verdad.
  stock            Int     @default(0)
  /// Si se puede vender sin stock. Vender contra pedido es normal; que pase
  /// sin querer no lo es, y por eso se decide por variante y no una vez global.
  permiteNegativo  Boolean @default(false)

  /// Cuál de las fotos del producto es la de esta variante. Sin elegir
  /// ninguna muestra la primera: lo que la foto enseña suele ser un eje solo
  /// —el color— y colgarla de la variante obligaría a subir la misma imagen
  /// una vez por talle.
  imagenId String?
  imagen   ProductoImagen? @relation(fields: [imagenId], references: [id], onDelete: SetNull)

  producto      Producto               @relation(fields: [productoId], references: [id], onDelete: Cascade)
  valores       VarianteValor[]
  movimientos   MovimientoInventario[]
  ordenLineas   OrdenLinea[]
  facturaLineas FacturaLinea[]

  @@unique([productoId, combinacion])
  @@index([productoId])
  @@index([imagenId])
}

/// Qué valor de cada opción tiene la variante.
model VarianteValor {
  varianteId String
  valorId    String

  variante Variante    @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  valor    ValorOpcion @relation(fields: [valorId], references: [id], onDelete: Cascade)

  @@id([varianteId, valorId])
  @@index([valorId])
}

/// Una foto del producto.
///
/// **Del producto y no de la variante.** Lo que una foto muestra suele ser un
/// eje solo, así que colgarla de cada combinación obligaría a subir la misma
/// imagen una vez por talle: con 3 colores × 4 tamaños, la foto del rojo iría
/// cuatro veces. La variante elige cuál de estas es la suya.
/// El archivo en sí, subido una vez y usable en varios productos.
///
/// Existe porque la misma foto se usa en más de un lado —el abono en su ficha y
/// en la del combo que lo incluye— y sin una biblioteca había que subirla dos
/// veces: dos objetos en R2, y renombrar uno dejaba al otro viejo.
model Media {
  id          String  @id @default(cuid())
  /// Dónde vive en R2. Único: es el archivo, y dos filas apuntando al mismo
  /// harían que borrar una dejara a la otra colgada de un objeto que ya no está.
  key         String  @unique
  /// Cómo se llamaba el archivo al subirlo. Es con lo que se lo busca en la
  /// biblioteca: el `key` es un uuid y no le dice nada a nadie.
  nombre      String
  /// Para lectores de pantalla y para cuando la imagen no carga.
  alt         String?
  contentType String

  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("MediaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  productos     ProductoImagen[]
  categorias    Categoria[]
  informesFotos InformeSeccionFoto[]

  @@index([createdAt])
}

/// Qué imágenes de la biblioteca usa un producto, y en qué orden.
///
/// Sacar una de acá la saca **del producto**, no de la biblioteca: la foto
/// sigue disponible para otro. Borrarla de verdad es otra acción, y la FK a
/// `Media` es `Restrict` para que no se pueda mientras algún producto la use.
model ProductoImagen {
  id         String @id @default(cuid())
  productoId String
  mediaId    String
  posicion   Int    @default(0)

  createdAt DateTime @default(now())

  producto  Producto   @relation(fields: [productoId], references: [id], onDelete: Cascade)
  media     Media      @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  variantes Variante[]

  /// La misma foto no entra dos veces en el mismo producto.
  @@unique([productoId, mediaId])
  @@index([productoId, posicion])
  @@index([mediaId])
}

/// Por qué se movió el stock.
enum MotivoMovimiento {
  /// Entró mercadería.
  INGRESO
  /// Corrección a mano, con su nota.
  AJUSTE
  /// Una toma de inventario: la cantidad pasa a ser la contada.
  CONTEO
  /// Salió por una venta.
  VENTA
  /// Volvió por una devolución.
  DEVOLUCION
}

/// Cada vez que el stock de una variante cambió, y por qué.
///
/// **El stock se lleva en un libro**, igual que las ventas. Un número suelto
/// contesta "cuánto hay" y ninguna otra pregunta: quién lo cambió, cuándo, y
/// contra qué. Cuando alguien discute un conteo, lo que se mira es esto.
model MovimientoInventario {
  id         String @id @default(cuid())
  varianteId String

  /// Positivo entra, negativo sale.
  cantidad Int
  /// Cuánto quedó después de este movimiento, congelado. Sin esto, saber cómo
  /// estaba el stock en una fecha obliga a sumar el libro entero desde cero.
  saldo    Int
  motivo   MotivoMovimiento
  nota     String?

  /// Qué factura lo movió, en un `VENTA` o una `DEVOLUCION`. Es lo que hace
  /// que "¿por qué bajó?" se pueda contestar sin adivinar. `SetNull` y no
  /// `Restrict`: el movimiento pasó y sigue siendo cierto aunque la factura se
  /// vaya de la base.
  facturaId String?

  createdAt       DateTime @default(now())
  createdById     String?
  /// El nombre al momento de moverlo: el id se vacía si borran la cuenta, y un
  /// movimiento sin autor no se puede explicar. El mismo par que usan
  /// `Factura` y `OrdenLinea`.
  createdByNombre String?

  variante  Variante @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  factura   Factura? @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("MovimientoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([varianteId, createdAt])
  @@index([facturaId])
}

/// Un contrato recurrente. Agrupa uno o más productos que se cobran juntos en
/// el mismo ciclo: cada renovación genera una orden con una línea por ítem.
model Suscripcion {
  id           String         @id @default(cuid())
  /// Número corto para nombrarla: "Suscripción #12".
  ///
  /// Secuencia **propia**, independiente de la de órdenes. Que exista una orden
  /// #12 y una suscripción #12 a la vez está bien: son cosas distintas y en
  /// pantalla siempre van con su prefijo. Compartir una sola secuencia las
  /// dejaría salteadas —#3, #17, #40— sin ganar nada a cambio.
  numero       Int            @unique @default(autoincrement())
  clienteId    String
  estado       EstadoServicio @default(ACTIVO)
  /// El ciclo lo define la suscripción, no el producto: el mismo producto puede
  /// ser mensual para un cliente y trimestral para otro.
  periodicidad Periodicidad   @default(MENSUAL)
  fechaInicio  DateTime       @db.Date
  fechaFin     DateTime?      @db.Date
  notas        String?        @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  cliente   Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  createdBy User?             @relation("SuscripcionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?             @relation("SuscripcionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items     SuscripcionItem[]
  ordenes   Orden[]
  visitas   Visita[]

  @@index([clienteId, estado])
}

/// Un producto dentro de una suscripción, con su propio precio e IVA. La tasa
/// va acá y no en la cabecera porque una misma factura puede mezclar líneas al
/// 0% y al 15%.
model SuscripcionItem {
  id                String  @id @default(cuid())
  suscripcionId     String
  productoId        String
  precio            Decimal @db.Decimal(10, 2)
  ivaTasa           Decimal @default(0) @db.Decimal(5, 2)
  /// Visitas que incluye **por período de cobro**: en una trimestral son las
  /// del trimestre. Es informativo — no es un tope, se puede agendar de más.
  visitasPorPeriodo Int?

  suscripcion     Suscripcion      @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)
  producto        Producto         @relation(fields: [productoId], references: [id], onDelete: Restrict)
  visitaProductos VisitaProducto[]
  ordenLineas     OrdenLinea[]

  @@unique([suscripcionId, productoId])
  @@index([productoId])
}

model Personal {
  id           String    @id @default(cuid())
  nombre       String
  apellido     String?
  telefono     String?
  especialidad String?
  sueldo       Float?
  tipo         String?
  estado       String    @default("ACTIVO")
  userId       String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  createdById String?
  updatedById String?
  createdBy   User?   @relation("JardineroCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("JardineroUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  user    User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  grupos  GrupoMiembro[]
  visitas VisitaPersonal[]
}

model Grupo {
  id          String    @id @default(cuid())
  nombre      String
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdById String?
  updatedById String?
  createdBy   User?   @relation("GrupoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("GrupoUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  miembros GrupoMiembro[]
  visitas  Visita[]
}

model Visita {
  id                  String       @id @default(cuid())
  /// Número corto para nombrarla: "Visita #34".
  ///
  /// Secuencia propia, como la de órdenes y suscripciones. En pantalla siempre
  /// va con su prefijo, así que que coexistan la orden #34 y la visita #34 no
  /// confunde a nadie.
  numero              Int          @unique @default(autoincrement())
  clienteId           String
  /// De qué plan es esta visita, si es de alguno.
  ///
  /// La decisión es **de la visita**, no de cada producto: "esta visita es del
  /// plan mensual" o "esta visita es un trabajo aparte". Con el plan puesto,
  /// cada producto que **esté en ese plan** queda cubierto —eso ya no se
  /// decide, se deduce del plan— y lo que no esté se cobra como trabajo suelto.
  ///
  /// En null, todo lo que se haga se cobra aparte. Es lo que permite hacerle a
  /// alguien una visita extra de algo que igual tiene contratado.
  suscripcionId       String?
  fechaProgramada     DateTime     @db.Date
  fechaRealizada      DateTime?    @db.Date
  horaEntrada         String?
  horaSalida          String?
  estado              EstadoVisita @default(PROGRAMADA)
  grupoId             String?
  notas               String?      @db.Text
  notasIncompleto     String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?
  createdById         String?
  updatedById         String?
  /// El nombre de quien la tocó al final, tal como se llamaba entonces.
  ///
  /// Junto al id y no en su lugar: el id sirve para filtrar por persona, pero
  /// se queda sin dueño si la cuenta se elimina, y si alguien se cambia el
  /// apellido no corresponde reescribir lo que ya pasó. El texto es lo que se
  /// muestra; el id, lo que se consulta.
  updatedByNombre     String?
  /// Cuándo se cerró como completada, y quién apretó el botón.
  ///
  /// No es `fechaRealizada`: esa es el **día en que se hizo el trabajo**, la
  /// elige quien la cierra y puede ser anterior —el lunes se cierra una visita
  /// hecha el viernes—. Esto es el instante en que quedó registrada.
  ///
  /// Y no es `updatedById`: ese es el último que la tocó por cualquier motivo,
  /// así que una corrección de fecha tres semanas después borra el rastro de
  /// quién la completó. Por eso son campos aparte.
  ///
  /// Se ponen al pasar a COMPLETADA y se limpian si sale de ese estado: si la
  /// visita ya no está completada, no hay nadie que la haya completado.
  completadaEl        DateTime?
  completadaPorId     String?
  /// El nombre de quien la completó, congelado en ese momento. Ver
  /// `updatedByNombre`: mismo motivo.
  completadaPorNombre String?

  cliente        Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  productos      VisitaProducto[]
  grupo          Grupo?            @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  createdBy      User?             @relation("VisitaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?             @relation("VisitaUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  completadaPor  User?             @relation("VisitaCompletadaPor", fields: [completadaPorId], references: [id], onDelete: SetNull)
  media          VisitaMedia[]
  personal       VisitaPersonal[]
  notificaciones NotificacionLog[]
  messages       VisitaMessage[]
  chatReads      VisitaChatRead[]
  informes       InformeVisita[]
  ordenes        OrdenVisita[]
  suscripcion    Suscripcion?      @relation(fields: [suscripcionId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([suscripcionId])
  @@index([fechaProgramada])
  /// Para filtrar "completadas entre estas fechas" sin recorrer la tabla.
  @@index([completadaEl])
}

/// Una visita puede cubrir varios servicios contratados del mismo cliente.
/// Un producto cubierto por una visita. Una visita puede cubrir varios.
///
/// **No lleva plata.** El precio de un trabajo se decide al facturarlo, en la
/// orden, igual que todo el resto del dinero del sistema. Acá solo vive el
/// hecho: qué se hizo y si estaba cubierto por un plan.
model VisitaProducto {
  id                String    @id @default(cuid())
  visitaId          String
  /// Qué se hizo. Siempre presente, venga de una suscripción o sea trabajo suelto.
  productoId        String
  /// Puesto = el plan lo cubre y no se cobra aparte. Null = trabajo suelto, se
  /// factura creando una orden. No es plata: es cobertura.
  suscripcionItemId String?
  /// En qué lugar de la lista va, nada más. Se llamaba `orden` y se leía como
  /// "a qué orden pertenece", que es justo lo que **no** es: eso vive en
  /// `OrdenLinea.visitaProductoId`. `OrdenLinea` ya usaba `posicion` para lo
  /// mismo.
  posicion          Int       @default(0)
  /// Cuándo se soltó de una orden anulada.
  ///
  /// Anular libera la procedencia, así que el trabajo vuelve a "pendiente" y no
  /// queda ni rastro de que alguna vez estuvo facturado. Sin esta marca, el
  /// proceso que arma borradores lo volvería a agarrar y pisaría la decisión de
  /// no cobrarlo. Facturarlo a mano sigue siendo posible: esto solo frena a los
  /// automatismos.
  liberadoAt        DateTime?

  visita           Visita            @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  producto         Producto          @relation(fields: [productoId], references: [id], onDelete: Restrict)
  suscripcionItem  SuscripcionItem?  @relation(fields: [suscripcionItemId], references: [id], onDelete: SetNull)
  /// Dónde se cobró, si ya se cobró. El id es único en `OrdenLineaOrigen`, así
  /// que esto es a lo sumo uno: un trabajo se factura una sola vez.
  ordenLineaOrigen OrdenLineaOrigen?

  @@unique([visitaId, productoId])
  @@index([productoId])
  @@index([suscripcionItemId])
}

model VisitaPersonal {
  id          String    @id @default(cuid())
  visitaId    String
  personalId  String
  addedAt     DateTime  @default(now())
  addedById   String?
  removedAt   DateTime?
  removedById String?

