# ─────────────────────────────────────────────────────────────
# apps/admin environment variables
# Copy to `apps/admin/.env` and fill in real values.
# Only DATABASE_URL is strictly required to boot. The mobile-auth
# secrets are required for the mobile app's login to work. Everything
# else degrades gracefully / no-ops until configured.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL) — REQUIRED
DATABASE_URL="postgresql://user:password@localhost:5432/vivero_francisco"

# Mobile auth — JWT signing secrets (separate access/refresh).
# Required for /api/mobile/auth/* to work. Generate with: openssl rand -base64 32
MOBILE_ACCESS_SECRET=""
MOBILE_REFRESH_SECRET=""

# Public base URL of the admin app — used to build the set-password link sent
# to clientes by email/WhatsApp. e.g. http://localhost:3001 in dev.
APP_BASE_URL="http://localhost:3001"

# Email (Gmail API) — sends the cliente set-password invite link via a Google
# service account with domain-wide delegation. The service account impersonates
# GMAIL_SENDER (a Workspace mailbox) with the gmail.send scope. Set up:
#   1. Google Cloud project -> enable Gmail API -> create a service account.
#   2. Create a JSON key; use its client_email and private_key below.
#   3. Workspace Admin console -> Security -> API controls -> Domain-wide
#      delegation -> add the service account Client ID with scope
#      https://www.googleapis.com/auth/gmail.send
# If GMAIL_CLIENT_EMAIL/GMAIL_PRIVATE_KEY/GMAIL_SENDER are unset, emails are
# printed to the server console (dev bypass).
GMAIL_CLIENT_EMAIL=""          # service account email (…@…iam.gserviceaccount.com)
GMAIL_PRIVATE_KEY=""           # service account private_key (keep the \n escapes, wrap in quotes)
GMAIL_SENDER="no-reply@viverofrancisco.com"   # Workspace mailbox to send as
EMAIL_FROM="Vivero Francisco <no-reply@viverofrancisco.com>"   # From header

# Object storage — Cloudflare R2 (S3-compatible). Region is always "auto".
# Needed for media uploads (visit photos/videos, logos) and PDF report assets.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL_BASE=""   # public base URL objects are served from (r2.dev or custom CDN)

# WhatsApp (Meta Cloud API) — sends notifications + cliente invite links, receives inbound messages.
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""   # must match the token configured in the Meta webhook

# Push notifications (Expo) — used by lib/push when sending to mobile devices.
EXPO_ACCESS_TOKEN=""

# Rate limiting (Upstash Redis). If unset, rate limiting is disabled (always-allow).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cron — shared secret guarding /api/cron/* (scheduled notifications).
CRON_SECRET=""
