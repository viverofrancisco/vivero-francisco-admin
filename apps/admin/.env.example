# ─────────────────────────────────────────────────────────────
# apps/admin environment variables
# Copy to `apps/admin/.env` and fill in real values.
# Only DATABASE_URL is strictly required to boot, but en producción hacen
# falta además las de NextAuth: sin ellas nadie entra al dashboard. Las de
# mobile-auth son necesarias para el login de la app. El resto degrada solo
# —la función queda apagada— hasta que se configure.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL) — REQUIRED
DATABASE_URL="postgresql://user:password@localhost:5432/vivero_francisco"

# NextAuth (login del dashboard) — REQUERIDAS en producción.
# Sin `NEXTAUTH_SECRET` no se firman las sesiones y nadie puede entrar; en dev
# se autogenera una, y por eso el problema recién aparece al desplegar.
# `NEXTAUTH_URL` es la URL pública del portal, la de los callbacks de login.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3001"

# Mobile auth — JWT signing secrets (separate access/refresh).
# Required for /api/mobile/auth/* to work. Generate with: openssl rand -base64 32
MOBILE_ACCESS_SECRET=""
MOBILE_REFRESH_SECRET=""

# Public base URL of the admin app — the root of every set-password link:
# invitations and resets for portal users, and cliente invitations. Must match
# where the app is actually served (dev included: if you run on 3000, this says
# 3000). Falls back to NEXTAUTH_URL, which is the same value; **one of the two
# is required in production** — without either, links are built against
# localhost, which doesn't fail here but in the recipient's inbox, so the code
# throws instead.
APP_BASE_URL="http://localhost:3001"

# Email (Gmail API, OAuth2) — sends the cliente set-password invite link. Uses
# OAuth2 with a refresh token (no service-account key; the org blocks those).
# Set up:
#   1. Google Cloud project -> enable Gmail API.
#   2. APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#      (type "Web application"); use its client_id + client_secret below.
#   3. Get a refresh token for the SENDER mailbox with scope
#      https://www.googleapis.com/auth/gmail.send (e.g. via the OAuth Playground
#      configured with your own client_id/secret). See .claude/docs/autenticacion-clientes.md
# The email is sent AS the account that authorized the refresh token; EMAIL_FROM
# must be that account (or a "send mail as" alias of it). If any var is unset,
# emails are printed to the server console (dev bypass).
GMAIL_CLIENT_ID=""             # OAuth client ID (…apps.googleusercontent.com)
GMAIL_CLIENT_SECRET=""         # OAuth client secret
GMAIL_REFRESH_TOKEN=""         # refresh token of the sender mailbox (scope gmail.send)
EMAIL_FROM="Vivero Francisco <no-reply@viverofrancisco.com>"   # From header (= the authorizing account / alias)

# Object storage — Cloudflare R2 (S3-compatible). Region is always "auto".
# Needed for media uploads (visit photos/videos, logos) and PDF report assets.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL_BASE=""   # public base URL objects are served from (r2.dev or custom CDN)

# WhatsApp (Meta Cloud API) — sends notifications + cliente invite links, receives inbound messages.
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""   # must match the token configured in the Meta webhook

# Push notifications (Expo) — used by lib/push when sending to mobile devices.
EXPO_ACCESS_TOKEN=""

# Rate limiting (Upstash Redis). If unset, rate limiting is disabled (always-allow).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cron — shared secret guarding /api/cron/* (scheduled notifications).
CRON_SECRET=""

# ── Contífico (facturación electrónica) ────────────────────────────
# Contífico genera el XML, firma y transmite al SRI: el portal solo manda el
# documento y consulta el estado.
CONTIFICO_API_KEY="..."          # va crudo en el header Authorization, sin "Bearer"
CONTIFICO_TOKEN="..."            # es el campo `pos` que exige cada documento
CONTIFICO_ESTABLECIMIENTO="001"
CONTIFICO_PUNTO_EMISION="002"    # serie propia del portal, para no chocar con lo emitido a mano
CONTIFICO_SECUENCIAL_INICIAL="0" # piso cuando la serie ya tiene documentos por fuera
CONTIFICO_SERIE_DNA="VF"         # prefijo de los documentos SIN factura (DNA). Contífico
                                 # no valida su numeración —acepta repetidos— así que la
                                 # unicidad la pone el portal: VF-000000001, VF-000000002…

# ── Facturación electrónica propia (SRI) ─────────────────────────────────
# Con qué se cifran los certificados de firma (.p12) guardados en la base.
# Un .p12 firma documentos tributarios a nombre del contribuyente: sin esta
# clave no se puede cargar ninguno, y cambiarla deja ilegibles los ya
# guardados — habría que volver a subirlos.
FIRMA_ENCRYPTION_KEY=""
