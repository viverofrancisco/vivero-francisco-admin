{
  "expo": {
    "name": "Vivero Francisco",
    "slug": "vivero-francisco",
    "owner": "vivero-francisco",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "viverofrancisco",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.viverofrancisco.app",
      "associatedDomains": [
        "applinks:admin.viverofrancisco.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.viverofrancisco.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "admin.viverofrancisco.com",
              "pathPrefix": "/establecer-contrasena"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vivero Francisco usa tu ubicación para marcar en el mapa dónde es tu jardín o adónde llevar tu pedido.",
          "isAndroidBackgroundLocationEnabled": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Vivero Francisco muestra tus fotos y videos para que elijas cuáles adjuntar a una solicitud o a la calificación de una visita.",
          "savePhotosPermission": "Vivero Francisco no guarda fotos en tu galería.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Vivero Francisco usa la cámara para tomar fotos de tu jardín para una solicitud o una calificación.",
          "microphonePermission": "Vivero Francisco usa el micrófono cuando grabas un video de tu jardín.",
          "photosPermission": "Vivero Francisco muestra tus fotos y videos para que elijas cuáles adjuntar a una solicitud o a la calificación de una visita."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "223ffdcd-fa35-4bc2-9864-c7eef7a74aa9"
      },
      "app": "clientes"
    }
  }
}
