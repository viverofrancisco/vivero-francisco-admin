+  /** El aumento que lleva el pellizco; el `zoomState` de CameraX se actualiza tarde. */
+  private var ratioDelPellizco = 1f
+  /**
+   * Hasta cuándo no se aplica la prop `zoom`: JS la devuelve con lo que el
+   * pellizco ya puso, y ese eco llega con unos cuadros de atraso y lo deshacía.
+   */
+  private var ignorarZoomHasta = 0L
+  private var huboPellizco = false
+
+  private val pellizco by lazy {
+    ScaleGestureDetector(
+      context,
+      object : ScaleGestureDetector.SimpleOnScaleGestureListener() {
+        override fun onScaleBegin(detector: ScaleGestureDetector): Boolean {
+          huboPellizco = true
+          ratioDelPellizco = camera?.cameraInfo?.zoomState?.value?.zoomRatio ?: 1f
+          return camera != null
+        }
+
+        override fun onScale(detector: ScaleGestureDetector): Boolean {
+          val c = camera ?: return false
+          val maximo = c.cameraInfo.zoomState.value?.maxZoomRatio ?: 1f
+          ratioDelPellizco = (ratioDelPellizco * detector.scaleFactor).coerceIn(1f, max(1f, maximo))
+          ignorarZoomHasta = SystemClock.uptimeMillis() + 600
+          c.cameraControl.setZoomRatio(ratioDelPellizco)
+          onZoomNativo(ZoomNativoEvent(ratioDelPellizco, maximo))
+          return true
+        }
+      }
+    )
+  }
+
+  private val toque by lazy {
+    GestureDetector(
+      context,
+      object : GestureDetector.SimpleOnGestureListener() {
+        override fun onDown(e: MotionEvent) = true
+
+        override fun onSingleTapUp(e: MotionEvent): Boolean {
+          if (!huboPellizco) {
+            enfocarEn(e.x, e.y)
+          }
+          return true
+        }
+      }
+    )
+  }
