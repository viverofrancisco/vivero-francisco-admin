{
  "name": "vivero-francisco",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev -w apps/admin",
    "dev:mobile": "npm run start -w apps/mobile",
    "build:admin": "npm run build -w apps/admin",
    "lint:admin": "npm run lint -w apps/admin",
    "migrate:dev": "npm run migrate:dev -w apps/admin",
    "migrate:deploy": "npm run migrate:deploy -w apps/admin",
    "migrate:status": "npm run migrate:status -w apps/admin"
  },
  "devDependencies": {
    "expo-router": "~6.0.23"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-worklets": "0.5.1"
  }
}
